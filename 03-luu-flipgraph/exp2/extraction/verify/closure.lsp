(include-book "../authors/main")
(include-book "../authors/scheme-algo")
(defttag :x)
(set-raw-mode-on!)
(defun supp (fn wrld)
  (let* ((b (body fn nil wrld))
         (g (getpropc fn 'guard nil wrld))
         (j (getpropc fn 'justification nil wrld))
         (m (and j (access justification j :measure)))
         (c (getpropc fn 'constraint-lst nil wrld))
         (c (if (symbolp c) nil c))
         (d (getpropc fn 'defchoose-axiom nil wrld)))
    (all-fnnames1 t (list* (or b 0) (or g 0) (or m 0) (or d 0) c) nil)))
(defun clos (todo seen wrld)
  (if (endp todo) seen
    (let ((f (car todo)))
      (if (member-eq f seen) (clos (cdr todo) seen wrld)
        (clos (append (supp f wrld) (cdr todo)) (cons f seen) wrld)))))
(defun show (name roots)
  (let ((r (clos roots nil (w *the-live-state*))))
    (format t "~%CLOS ~a ~s~%" name (reverse r))))
(show "M1" '(correct-schemep path-validp apply-moves))
(show "M2" '(algop algo-correctp algo-scheme correct-schemep))
(show "M3" '(correct-schemep algo-correctp scheme-algo schemep algo-scheme))
