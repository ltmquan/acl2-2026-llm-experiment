; Smtlink 3 (reimplementation) -- base definitions
;
; This book contains the logical infrastructure shared by all the clause
; processors of Smtlink 3:
;
;  - the tag functions used to carry Smtlink's state from one clause
;    processor to the next (SMTLINK-GOAL, SMTLINK-SIDE),
;  - the functions TI-EQUAL and ANY-P used by type inference,
;  - the evaluator SMT-EV against which the verified clause processors are
;    proved correct, and some lemmas about it,
;  - the representation of "typed terms" and of the "smt-judgement" (the
;    unconditional type judgements of a goal) together with
;    SMT-JUDGEMENT->EXPR, which interprets an smt-judgement as an ACL2 term.
;
; Nothing in this book is trusted.

(in-package "SMT")
(include-book "std/osets/top" :dir :system)
(set-verify-guards-eagerness 0)

; ----------------------------------------------------------------------
; Tags

; A clause on its way through Smtlink has the shape
;
;    ((not (smtlink-goal 'info)) (not H) lit1 ... litn)
;
; where INFO records the stage and the data computed so far, H is the "type
; correctness hypothesis" of the paper (initially 't) and lit1 ... litn are
; the literals of the goal.  Since (smtlink-goal x) = t, the first literal is
; always false, so the clause is equivalent to (implies H (or lit1 ... litn)).

(defun smtlink-goal (info)
  (declare (ignore info))
  t)

; Side goals generated by the clause processors are tagged with
; (not (smtlink-side 'theory)) so that the Smtlink computed hint can give
; them an appropriate theory.

(defun smtlink-side (theory)
  (declare (ignore theory))
  t)

; TI-EQUAL is EQUAL, but disabled, so that the rewriter leaves it alone
; while performing type inference (Section 5.2 of the paper).

(defun ti-equal (x y)
  (equal x y))

(in-theory (disable ti-equal))

; ANY-P is the trivial type: the judgement of terms of unconstrained type.

(defun any-p (x)
  (declare (ignore x))
  t)

; ----------------------------------------------------------------------
; The evaluator

(defevaluator smt-ev smt-ev-lst
  ((if a b c)
   (not a)
   (equal a b)
   (implies a b)
   (smtlink-goal x)
   (smtlink-side x)))

(defthm smt-ev-disjoin2
  (iff (smt-ev (disjoin2 x y) a)
       (or (smt-ev x a) (smt-ev y a)))
  :hints (("Goal" :in-theory (enable disjoin2))))

(defthm smt-ev-disjoin-cons
  (iff (smt-ev (disjoin (cons x y)) a)
       (or (smt-ev x a) (smt-ev (disjoin y) a)))
  :hints (("Goal" :expand ((disjoin (cons x y))))))

(defthm smt-ev-disjoin-append
  (iff (smt-ev (disjoin (append x y)) a)
       (or (smt-ev (disjoin x) a) (smt-ev (disjoin y) a)))
  :hints (("Goal" :induct (append x y))))

(defthm smt-ev-conjoin2
  (iff (smt-ev (conjoin2 x y) a)
       (and (smt-ev x a) (smt-ev y a)))
  :hints (("Goal" :in-theory (enable conjoin2))))

(defthm smt-ev-conjoin-cons
  (iff (smt-ev (conjoin (cons x y)) a)
       (and (smt-ev x a) (smt-ev (conjoin y) a)))
  :hints (("Goal" :expand ((conjoin (cons x y))))))

(defthm smt-ev-conjoin-clauses-cons
  (iff (smt-ev (conjoin-clauses (cons c cs)) a)
       (and (smt-ev (disjoin c) a)
            (smt-ev (conjoin-clauses cs) a)))
  :hints (("Goal" :in-theory (enable conjoin-clauses disjoin-lst))))

(defthm smt-ev-conjoin-clauses-atom
  (implies (atom cs) (equal (smt-ev (conjoin-clauses cs) a) t))
  :hints (("Goal" :in-theory (enable conjoin-clauses disjoin-lst))))

(defthm conjoin-of-atom
  (implies (atom x) (equal (conjoin x) *t*))
  :hints (("Goal" :in-theory (enable conjoin))))

(defthm disjoin-of-atom
  (implies (atom x) (equal (disjoin x) *nil*))
  :hints (("Goal" :in-theory (enable disjoin))))

(in-theory (disable disjoin conjoin conjoin-clauses disjoin2 conjoin2))

; ----------------------------------------------------------------------
; Tagged clauses

(defun tag-lit (info)
  (list 'not (list 'smtlink-goal (list 'quote info))))

(defun side-lit (theory)
  (list 'not (list 'smtlink-side (list 'quote theory))))

(defthm smt-ev-tag-lit
  (not (smt-ev (tag-lit info) a)))

(defthm smt-ev-side-lit
  (not (smt-ev (side-lit theory) a)))

(in-theory (disable tag-lit side-lit))

(defun tag-info (cl)
  ;; (car cl) = (not (smtlink-goal (quote info)))
  (if (and (consp cl) (consp (car cl)) (consp (cdar cl)) (consp (cadar cl))
           (consp (cdr (cadar cl))) (consp (cadr (cadar cl)))
           (consp (cdr (cadr (cadar cl)))))
      (cadr (cadr (cadar cl)))
    nil))

(defun hyp-lit-p (x)
  (and (consp x) (eq (car x) 'not) (consp (cdr x)) (null (cddr x))))

(defun tagged-clause-p (cl)
  (and (consp cl)
       (consp (cdr cl))
       (equal (car cl) (tag-lit (tag-info cl)))
       (hyp-lit-p (cadr cl))))

(defun clause-hyp (cl)
  (if (and (consp cl) (consp (cdr cl)) (hyp-lit-p (cadr cl)))
      (cadr (cadr cl))
    *t*))

(defun clause-lits (cl)
  (if (and (consp cl) (consp (cdr cl))) (cddr cl) nil))

(defthm smt-ev-disjoin-tagged-clause
  (implies (tagged-clause-p cl)
           (iff (smt-ev (disjoin cl) a)
                (or (not (smt-ev (clause-hyp cl) a))
                    (smt-ev (disjoin (clause-lits cl)) a))))
  :hints (("Goal" :in-theory (disable smt-ev-disjoin-cons)
           :use ((:instance smt-ev-disjoin-cons (x (car cl)) (y (cdr cl)))
                 (:instance smt-ev-disjoin-cons (x (cadr cl)) (y (cddr cl)))))))

(defun make-main (info hyp lits)
  (list* (tag-lit info) (list 'not hyp) lits))

(defthm smt-ev-disjoin-make-main
  (iff (smt-ev (disjoin (make-main info hyp lits)) a)
       (or (not (smt-ev hyp a))
           (smt-ev (disjoin lits) a))))

(defun make-side (theory lits)
  (cons (side-lit theory) lits))

(defthm smt-ev-disjoin-make-side
  (iff (smt-ev (disjoin (make-side theory lits)) a)
       (smt-ev (disjoin lits) a)))

(in-theory (disable tagged-clause-p clause-hyp clause-lits make-main make-side))

; ----------------------------------------------------------------------
; The INFO record carried by the tag: an alist.

(defun info-get (key info)
  (if (alistp info) (cdr (assoc-equal key info)) nil))

(defun info-set (key val info)
  (cons (cons key val)
        (if (alistp info)
            (remove1-assoc-equal key info)
          nil)))

(defun info-stage (info)
  (info-get :stage info))

; ----------------------------------------------------------------------
; Typed terms
;
; A typed term is a node of the form
;
;   ((judgements . J) (smt-judgements . S) (guts . G))
;
; where J and S are ordered sets of judgements -- terms (r x) where r is a
; type recognizer and x is the placeholder variable SMT::X -- and G is one of
;
;   (:var v)              a variable
;   (:quote c)            a constant
;   (:fncall f . args)    a function application; args are typed terms
;   (:lambda term)        a lambda application (treated as opaque)
;
; The invariant (S a subset of J, except for the trivial judgement
; (any-p x)) is maintained by type fixing but is never relied upon for
; soundness.

(defun make-tt (judgements smt-judgements guts)
  (list (cons 'judgements judgements)
        (cons 'smt-judgements smt-judgements)
        (cons 'guts guts)))

(defun tt-judgements (tt)
  (if (and (consp tt) (consp (car tt))) (cdar tt) nil))

(defun tt-smt-judgements (tt)
  (if (and (consp tt) (consp (cdr tt)) (consp (cadr tt))) (cdadr tt) nil))

(defun tt-guts (tt)
  (if (and (consp tt) (consp (cdr tt)) (consp (cddr tt)) (consp (caddr tt)))
      (cdr (caddr tt))
    nil))

(defun guts-kind (g)
  (if (consp g) (car g) nil))

(defun guts-arg (g) ; the variable, constant, function symbol or lambda term
  (if (and (consp g) (consp (cdr g))) (cadr g) nil))

(defun guts-args (g) ; typed arguments of a :fncall
  (if (and (consp g) (consp (cdr g))) (cddr g) nil))

(defthm acl2-count-of-guts-args
  (<= (acl2-count (guts-args (tt-guts tt)))
      (acl2-count tt))
  :rule-classes :linear)

(defthm acl2-count-of-guts-args-strong
  (implies (consp tt)
           (< (acl2-count (guts-args (tt-guts tt)))
              (acl2-count tt)))
  :rule-classes :linear)

(defun judgement-recognizer (j)
  (if (consp j) (car j) nil))

(defun make-judgement (r)
  (list r 'x))

(defun judgement-recognizers (js)
  (if (atom js)
      nil
    (cons (judgement-recognizer (car js))
          (judgement-recognizers (cdr js)))))

(defun tt-chosen (tt)
  ;; The recognizer of the selected smt judgement of a node (any-p if none).
  (let ((s (tt-smt-judgements tt)))
    (if (and (consp s) (symbolp (judgement-recognizer (car s)))
             (judgement-recognizer (car s)))
        (judgement-recognizer (car s))
      'any-p)))

; The term represented by a typed term.

(mutual-recursion
 (defun tt-term (tt)
   (declare (xargs :measure (acl2-count tt)))
   (let ((g (tt-guts tt)))
     (case (guts-kind g)
       (:var (guts-arg g))
       (:quote (list 'quote (guts-arg g)))
       (:fncall (cons (guts-arg g) (tt-term-list (guts-args g))))
       (otherwise (guts-arg g)))))
 (defun tt-term-list (tts)
   (declare (xargs :measure (acl2-count tts)))
   (if (atom tts)
       nil
     (cons (tt-term (car tts))
           (tt-term-list (cdr tts))))))

; ----------------------------------------------------------------------
; The type correctness hypothesis produced by type inference: for every
; node of every typed term, and every judgement (r x) of the node,
;
;    (implies <path condition> (r <term of the node>))

(defun implies-term (hyps concl)
  (if (atom hyps)
      concl
    (list 'if (conjoin hyps) concl *t*)))

(defun judgement-terms (js term)
  (if (atom js)
      nil
    (cons (list (judgement-recognizer (car js)) term)
          (judgement-terms (cdr js) term))))

(defun implies-terms (pc concls)
  (if (atom concls)
      nil
    (cons (implies-term pc (car concls))
          (implies-terms pc (cdr concls)))))

(mutual-recursion
 (defun tt-judgement-conjuncts (tt pc)
   (declare (xargs :measure (acl2-count tt)))
   (let* ((g (tt-guts tt))
          (here (implies-terms pc (judgement-terms (tt-judgements tt)
                                                   (tt-term tt)))))
     (if (eq (guts-kind g) :fncall)
         (if (and (eq (guts-arg g) 'if)
                  (consp (guts-args g))
                  (consp (cdr (guts-args g)))
                  (consp (cddr (guts-args g))))
             (let* ((args (guts-args g))
                    (test (tt-term (car args))))
               (append here
                       (tt-judgement-conjuncts (car args) pc)
                       (tt-judgement-conjuncts (cadr args) (cons test pc))
                       (tt-judgement-conjuncts (caddr args)
                                               (cons (list 'not test) pc))))
           (append here (tt-list-judgement-conjuncts (guts-args g) pc)))
       here)))
 (defun tt-list-judgement-conjuncts (tts pc)
   (declare (xargs :measure (acl2-count tts)))
   (if (atom tts)
       nil
     (append (tt-judgement-conjuncts (car tts) pc)
             (tt-list-judgement-conjuncts (cdr tts) pc)))))

(defun typed-terms-hyp (tts)
  ;; The type correctness hypothesis for a list of typed terms (one per
  ;; literal of the clause).
  (conjoin (tt-list-judgement-conjuncts tts nil)))

; ----------------------------------------------------------------------
; Smt-judgements: the unconditional type judgements of a goal
;
;  ((vars ((name . v) (judgement . r)) ...)
;   (fns  ((name . f) (domain r1 ... rn) (range . r)) ...))

(defun smtj-vars (smtj)
  (if (alistp smtj) (cdr (assoc-eq 'vars smtj)) nil))

(defun smtj-fns (smtj)
  (if (alistp smtj) (cdr (assoc-eq 'fns smtj)) nil))

(defun entry-get (key entry)
  (if (alistp entry) (cdr (assoc-eq key entry)) nil))

; Fresh variables for function judgements.
(defconst *judgement-vars*
  '(x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16))

(defun judgement-var-list (n vars)
  (if (or (zp n) (atom vars))
      nil
    (cons (car vars) (judgement-var-list (1- n) (cdr vars)))))

(defun domain-hyps (domain vars)
  (if (or (atom domain) (atom vars))
      nil
    (cons (list (car domain) (car vars))
          (domain-hyps (cdr domain) (cdr vars)))))

(defun var-judgement-exprs (vars)
  (if (atom vars)
      nil
    (cons (list (entry-get 'judgement (car vars))
                (entry-get 'name (car vars)))
          (var-judgement-exprs (cdr vars)))))

(defun fn-judgement-expr (fn)
  (let* ((domain (entry-get 'domain fn))
         (xs (judgement-var-list (len domain) *judgement-vars*)))
    (list 'if (conjoin (domain-hyps domain xs))
          (conjoin (list (list (entry-get 'range fn)
                               (cons (entry-get 'name fn) xs))))
          *t*)))

(defun fn-judgement-exprs (fns)
  (if (atom fns)
      nil
    (cons (fn-judgement-expr (car fns))
          (fn-judgement-exprs (cdr fns)))))

(defun smt-judgement->expr (smtj)
  ;; An IF-encoded conjunction of the variable and function judgements.
  (list 'if (conjoin (var-judgement-exprs (smtj-vars smtj)))
        (conjoin (fn-judgement-exprs (smtj-fns smtj)))
        *nil*))
