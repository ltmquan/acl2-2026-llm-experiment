 "<scratch>/given-gamboa-stirling/defs.lisp"
ACL2(r) !>   d       1:x(INCLUDE-BOOK "defs")
              \
              [Included books, outermost to innermost:
               "<scratch>/given-gamboa-stirling/defs.lisp"
               "/opt/acl2r/books/arithmetic/factorial.lisp"
              ]
              \
>L d           (DEFUN FACTORIAL (N)
                 (IF (ZP N) 1 (* N (FACTORIAL (1- N)))))
ACL2(r) !>   d       1:x(INCLUDE-BOOK "defs")
              \
              [Included books, outermost to innermost:
               "<scratch>/given-gamboa-stirling/defs.lisp"
              ]
              \
>L             (DEFUN WALLIS-PRODUCT (N)
                 (IF (ZP N)
                     1
                   (* (/ (* 2 N) (1- (* 2 N)))
                      (/ (* 2 N) (1+ (* 2 N)))
                      (WALLIS-PRODUCT (1- N)))))
ACL2(r) !>   d       1:x(INCLUDE-BOOK "defs")
              \
              [Included books, outermost to innermost:
               "<scratch>/given-gamboa-stirling/defs.lisp"
