(defthm anext-rangep-as
  (implies (and (anext-rangep i n a) (natp v) (< v n))
           (anext-rangep i n (as j v a)))
  :hints (("Goal" :in-theory (enable anext-rangep ag-of-as-redux))))

(defthm anext-rangep-del-head-anext
  (implies (and (anext-rangep 0 (arr_sz) a)
                (natp s) (< s (arr_sz)) (natp f) (<= f (arr_sz))
                (not (equal s f)))
           (anext-rangep 0 (arr_sz) (del-head-anext s f a)))
  :hints (("Goal" :in-theory (enable del-head-anext))))

(defthm used-closedp-del-head-anext
  (implies (and (natp s) (natp f) (not (equal s f)) (not (zp k))
                (not (equal (ag s a) s))
                (aset-walk-closedp (ag s a) s k a)
                (no-duplicatesp-equal (aset-walk (ag s a) s k a))
                (implies (< f (arr_sz))
                         (not (member-equal f (aset-walk (ag s a) s k a)))))
           (aset-walk-closedp (ag (ag s a) a) s k (del-head-anext s f a)))
  :hints (("Goal" :in-theory (e/d (del-head-anext) (as-diff-as))
           :use ((:instance aset-walk-more-fuel
                            (idx (ag (ag s a) a)) (tail s)
                            (anext a) (k (1- k)) (k2 k))))))

(defthm free-closedp-del-head-anext
  (implies (and (natp s) (natp f) (not (equal s f)) (not (zp k))
                (< f (arr_sz))
                (not (equal (ag s a) f))
                (aset-walk-closedp (ag f a) f (1- k) a)
                (not (member-equal (ag s a) (aset-walk (ag f a) f (1- k) a)))
                (not (member-equal s (aset-walk (ag f a) f (1- k) a))))
           (aset-walk-closedp (ag f (del-head-anext s f a)) f k
                              (del-head-anext s f a)))
  :hints (("Goal" :in-theory (e/d (del-head-anext) (as-diff-as)))))

(defthm free-closedp-del-head-anext-empty
  (implies (and (not (zp k))
                (not (< f (arr_sz))))
           (aset-walk-closedp (ag (ag s a) (del-head-anext s f a)) (ag s a) k
                              (del-head-anext s f a)))
  :hints (("Goal" :in-theory (e/d (del-head-anext) (as-diff-as)))))

(defthm free-closedp-del-head-anext-empty-2
  (implies (and (not (zp k))
                (not (< f (arr_sz)))
                (equal (ag s a) s))
