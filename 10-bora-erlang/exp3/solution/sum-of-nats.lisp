; Section 4.1: the Erlang function sum_of_nats(N) computes N(N+1)/2.
;
;   sum_of_nats(0) -> 0;
;   sum_of_nats(N) when is_integer(N), 0 < N -> N + sum_of_nats(N-1).
;
; The AST of the module is generated by the front end from
; erl/sum_of_nats.erl (book erl/sum_of_nats.lisp).
;
; Strategy (as in the paper): introduce the ACL2 function sum-of-nats, show
; that evaluating the Erlang call returns
;   (make-erl-val-integer :val (sum-of-nats (erl-val-integer->val N)))
; given enough fuel -- 14 * (1 + N) suffices -- and then show that
; sum-of-nats matches the closed form.

(in-package "ACL2")

(include-book "evaluator")
(include-book "eval-lemmas")  ; controlled unrolling of eval-cont-list
(include-book "erl/sum_of_nats")
(local (include-book "arithmetic/top-with-meta" :dir :system))

; The Lisp version
(defun sum-of-nats (n)
  (if (zp n) 0 (+ n (sum-of-nats (- n 1)))))

(defthm sum-of-nats-closed-form
  (implies (natp n)
           (equal (sum-of-nats n) (/ (+ (* n n) n) 2))))

(in-theory (disable sum-of-nats-closed-form))

; The clauses of sum_of_nats/1, as produced by the front end.
(defconst *sum-of-nats-clauses*
  (cdr (assoc-equal '(|sum_of_nats| . 1) (module->functions *sum_of_nats-module*))))

; A logical world in which the module MOD maps sum_of_nats/1 to the clauses
; above.  Nothing else is assumed about the world.
(defun sum-test-world-p (world mod)
  (equal (erl-lookup-fn world mod '|sum_of_nats| 1) *sum-of-nats-clauses*))

(defthm sum-test-world-p-of-the-module
  (sum-test-world-p (erl-make-world (list *sum_of_nats-module*)) '|sum_of_nats|))

; The AST of the call sum_of_nats(N), where N is an :integer AST.
(defun sum-of-nats-call (n-ast)
  (list :call-local '|sum_of_nats| (list :cons n-ast '(:nil))))

; Fuel sufficient to evaluate sum_of_nats(N): linear in N.
(defun sum-of-nats-fuel (n) (* 14 (+ 1 n)))

; Number of continuations evaluated from the (:call-local |sum_of_nats|)
; continuation until its value is passed to the next continuation.
(defun sum-steps (n) (+ 4 (* 14 (nfix n))))

(in-theory (disable erl-lookup-fn))

; ---------------------------------------------------------------------------
; The beta-reduction of sum_of_nats(N): base case and inductive case.

(defmacro sum-hyps (n k s fuel)
  `(and (natp ,n)
        (sum-test-world-p (estate->world ,s) (estate->module ,s))
        (not (eq (car (car ,k)) :restore))
        (natp ,fuel)))

; the estate in which sum_of_nats is applied to the argument list (N)
(defmacro sum-arg-estate (n s)
  `(update-estate->val ,s (list (list :integer ,n))))

(defthm eval-sum-of-nats-base-case
  (implies (and (sum-hyps n k s fuel)
                (equal n 0)
                (<= 4 fuel))
           (equal (eval-cont-list (cons '(:call-local |sum_of_nats|) k) (sum-arg-estate n s) fuel)
                  (eval-cont-list k (update-estate->val s (list :integer 0)) (- fuel 4))))
  :hints (("Goal" :expand ((:free (s) (eval-cont-list (cons '(:call-local |sum_of_nats|) k)
                                                         s fuel))))))

; The state reached after 12 steps of the body of sum_of_nats(N), N > 0, at
; the recursive call sum_of_nats(N-1).
(defun sum-rec-klist (n k s)
  (list* (list :binop2 '+ (list :integer n))
         (list :restore (estate->env s) (estate->module s))
         k))

(defun sum-rec-env (n) (list (cons '|N| (list :integer n))))

(defthm eval-sum-of-nats-inductive-case
  (implies (and (sum-hyps n k s fuel)
                (< 0 n)
                (<= 12 fuel))
           (equal (eval-cont-list (cons '(:call-local |sum_of_nats|) k) (sum-arg-estate n s) fuel)
                  (eval-cont-list (cons '(:call-local |sum_of_nats|) (sum-rec-klist n k s))
                                  (sum-arg-estate (- n 1) (update-estate->env s (sum-rec-env n)))
                                  (- fuel 12))))
  :hints (("Goal" :expand ((:free (s) (eval-cont-list (cons '(:call-local |sum_of_nats|) k)
                                                         s fuel))))))

(defun sum-ind (n k s fuel)
  (if (zp n)
      (list k s fuel)
    (sum-ind (- n 1) (sum-rec-klist n k s) (update-estate->env s (sum-rec-env n)) (- fuel 12))))

(defthm eval-sum-of-nats-induct
  (implies (and (sum-hyps n k s fuel)
                (<= (sum-steps n) fuel))
           (equal (eval-cont-list (cons '(:call-local |sum_of_nats|) k) (sum-arg-estate n s) fuel)
                  (eval-cont-list k (update-estate->val s (list :integer (sum-of-nats n)))
                                  (- fuel (sum-steps n)))))
  :hints (("Goal" :induct (sum-ind n k s fuel)
                  :in-theory (disable eval-sum-of-nats-inductive-case
                                      eval-sum-of-nats-base-case))
          ("Subgoal *1/2" :use ((:instance eval-sum-of-nats-inductive-case)))
          ("Subgoal *1/1" :use ((:instance eval-sum-of-nats-base-case)))))

(defthmd erl-val-integer-p-shape
  (implies (erl-val-integer-p x)
           (equal (list :integer (cadr x)) x)))

; ---------------------------------------------------------------------------
; The main results.  N is an Erlang AST of type :integer whose value is a
; natural number; the world of the estate S must map sum_of_nats/1 in the
; current module to the clauses above; and there must be at least
; 14 * (1 + N) units of fuel.

(defthm eval-sum-of-nats
  (implies (and (erl-val-integer-p n-ast)
                (natp (erl-val-integer->val n-ast))
                (sum-test-world-p (estate->world s) (estate->module s))
                (natp fuel)
                (<= (sum-of-nats-fuel (erl-val-integer->val n-ast)) fuel))
           (equal (estate->val
                   (eval-cont-list (list (cont-expr :expr (sum-of-nats-call n-ast))) s fuel))
                  (make-erl-val-integer :val (sum-of-nats (erl-val-integer->val n-ast)))))
  :hints (("Goal" :use ((:instance eval-sum-of-nats-induct
                                   (n (cadr n-ast))
                                   (k nil)
                                   (fuel (- fuel 3))))
                  :in-theory (enable erl-val-integer-p-shape))))

; Equation (1):  sum_of_nats(N) = 1/2 (N^2 + N)
(defthm sum-of-nats-correct
  (implies (and (erl-val-integer-p n-ast)
                (natp (erl-val-integer->val n-ast))
                (sum-test-world-p (estate->world s) (estate->module s))
                (natp fuel)
                (<= (sum-of-nats-fuel (erl-val-integer->val n-ast)) fuel))
           (equal (estate->val
                   (eval-cont-list (list (cont-expr :expr (sum-of-nats-call n-ast))) s fuel))
                  (let ((n (erl-val-integer->val n-ast)))
                    (make-erl-val-integer :val (/ (+ (* n n) n) 2)))))
  :hints (("Goal" :use ((:instance eval-sum-of-nats)
                        (:instance sum-of-nats-closed-form (n (erl-val-integer->val n-ast))))
                  :in-theory (theory 'minimal-theory))))

; The same, stated with a natural number N and the fuel bound inline.
(defthm sum-of-nats-correct-nat
  (implies (and (natp n)
                (sum-test-world-p (estate->world s) (estate->module s))
                (natp fuel)
                (<= (* 14 (+ 1 n)) fuel))
           (equal (estate->val
                   (eval-cont-list
                    (list (cont-expr :expr (sum-of-nats-call (make-erl-val-integer :val n))))
                    s fuel))
                  (make-erl-val-integer :val (/ (+ (* n n) n) 2))))
  :hints (("Goal" :use ((:instance sum-of-nats-correct (n-ast (list :integer n))))
                  :in-theory (union-theories '(erl-val-integer-p erl-val-integer->val natp sum-of-nats-fuel erl-val-integer car-cons cdr-cons (:executable-counterpart equal) (:executable-counterpart consp))
                                             (theory 'minimal-theory)))))

; Concrete check: the evaluator really computes it, e.g. for N = 100.
(assert-event
 (equal (estate->val (erl-eval-call (erl-make-world (list *sum_of_nats-module*))
                                    '|sum_of_nats| '|sum_of_nats|
                                    (list (make-erl-val-integer :val 100)) 2000))
        (make-erl-val-integer :val 5050)))
