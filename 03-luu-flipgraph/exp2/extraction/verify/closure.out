                         STRING< COERCE STRINGP CHARACTER-LISTP CHARACTERP CDR
                         ACL2-COUNT RATIONALP INTEGERP NUMERATOR INTEGER-ABS <
                         UNARY-- ACL2-NUMBERP DENOMINATOR COMPLEX-RATIONALP
                         REALPART IMAGPART BINARY-+ LENGTH LEN TRUE-LISTP
                         STRING<-L ENDP EQL EQLABLEP CHAR< CHAR-CODE
                         SYMBOL-NAME = BAD-ATOM<= BAD-ATOM SUMMAND-LISTP
                         SUMMANDP MAT-TRIPLEP BIT-LIST-LISTP BIT-LIST-P BITP
                         BIT-MATP ZP BIT-LISTNP NATP NFIX SUMMAND0P SUMMAND-A
                         SUMMAND-B SUMMAND-C BIT-MAT0 BIT-LISTN0 REPEAT
                         MAKE-LIST-AC CONS RETURN-LAST SCHEME-SUM BINARY-*
                         SUMMAND-TENSOR TENSOR MAT-FLAT BINARY-APPEND
                         BIT-LIST-OUTER BIT-LIST-SCALE BITAND BVAND BVCHOP IFIX
                         EXPT ZIP FIX UNARY-/ ABS MINUSP MOD FLOOR
                         NONNEGATIVE-INTEGER-QUOTIENT BINARY-LOGAND EVENP
                         BIT-LIST-ADD BITXOR BVXOR BINARY-LOGXOR BINARY-LOGEQV
                         LOGORC1 LOGNOT BINARY-LOGIOR MAT-TRIPLE-LISTP
                         MM-TENSOR MM-TENSOR-1 MM-TENSOR-2 MM-TENSOR-3
                         BIT-MAT-UNIT BIT-UNIT-LIST PATH-VALIDP MOVE-VALIDP
                         SUMMAND-GET-POS MOVE-POS OBAG::OCCS OBAG::EMPTYP
                         OBAG::BFIX OBAG::HEAD OBAG::TAIL MOVE-S1 MOVE-S2
                         OBAG::IN MOVE-KIND MOVE-P APPLY-MOVE PLUS BIT-MAT-ADD
                         SUMMAND-SET-POS SUMMAND FLIP POS-NEXT POS-PREV
                         OBAG::DELETE OBAG::INSERT << LEXORDER ALPHORDER
                         STRING<= INSERT-ALL-NONZERO MOVE-LIST-P APPLY-MOVES)
CLOS M2 (ALGOP CONSP PROD-LISTP ATOM NOT IF NULL EQ EQUAL SYMBOLP CAR PRODP
               TRUE-LISTP CDR ACL2-COUNT RATIONALP INTEGERP NUMERATOR
               INTEGER-ABS < UNARY-- ACL2-NUMBERP DENOMINATOR COMPLEX-RATIONALP
               REALPART IMAGPART BINARY-+ STRINGP LENGTH COERCE CHARACTER-LISTP
