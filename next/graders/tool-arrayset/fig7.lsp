; Transcription of Figure 7 of hardin-arrayset (ASET_DEL as generated by the RAC translator).
; Data file for grade.sh R2 (not a book). The PDF's curly quotes are written as '.
(DEFUND ASET_DEL (VAL ASET)
 (LET ((PREV_INDEX (ARR_SZ)))
   (MV-LET
      (PREV_INDEX ASET)
      (IF1 (LOG< (AG 'USED_LST ASET) (ARR_SZ))
           (LET ((PREV_INDEX (ASET_FIND_VAL_FROM
                              (BITS (AG 'USED_LST ASET) 63 0)
                              (BITS (SI VAL 64) 63 0)
                              ASET)))
             (MV PREV_INDEX
                 (IF1 (LOGAND1 (LOG< PREV_INDEX (ARR_SZ))
                               (LOG<> PREV_INDEX (AG 'FREE_LST ASET)))
                      (LET ((ASET (AS 'USED_LST PREV_INDEX ASET)))
                        (ASET_DEL_HEAD ASET))
                      (AS 'ERR (ARR_SZ) ASET))))
           (MV PREV_INDEX (AS 'ERR (ARR_SZ) ASET)))
     ASET)))
