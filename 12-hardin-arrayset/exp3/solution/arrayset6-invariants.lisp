  :hints (("Goal" :use consp-aset-walk :in-theory (disable consp-aset-walk))))

(defthm no-duplicatesp-append-cons
  (equal (no-duplicatesp-equal (append x (cons a y)))
         (and (not (member-equal a x))
              (not (member-equal a y))
              (no-duplicatesp-equal (append x y)))))

(defthm no-duplicatesp-append-cdr
  (implies (no-duplicatesp-equal (append x y))
           (no-duplicatesp-equal (append (cdr x) y))))

(defthm no-duplicatesp-append-right
  (implies (no-duplicatesp-equal (append x y))
           (no-duplicatesp-equal y)))

