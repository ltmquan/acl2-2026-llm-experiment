; Section 4.2: Schwartz's parallel reduce, simplified (Figure 5):
;
;   reduce(none, [], GrandTotal) -> GrandTotal;
;   reduce(ParentPid, [], MyTotal) ->
;       ParentPid ! {self(), MyTotal};
;   reduce(ParentPid, [ChildHd | ChildTl], LeftTotal) ->
;       receive
;           {ChildHd, RightTotal} ->
;               reduce(ParentPid, ChildTl, LeftTotal + RightTotal)
;       end.
;
; The AST is generated by the front end from erl/reduce.erl.
;
; A worker tree (wtree-p) of n nodes is a list of node records
; (parent children hi): node i covers the index range [i, hi); its children
; c1 < c2 < ... < ck cover consecutive subranges [c1, hi(c1)), [hi(c1),
; hi(c2)) ... of [i+1, hi); the root 0 has no parent and covers [0, n).
; Worker i runs reduce(Parent, Children, i), so the value it eventually
; sends to its parent is the sum of the indices in its range.
;
; We prove, for every scheduler satisfying the fairness constraint:
;   reduce-invariant-preserved  the invariant is preserved by message
;                               delivery and by running a process, and so by
;                               every scheduler step and every trace;
;   reduce-no-blocked-worker    invariant + no non-stuttering action (and no
;                               worker out of fuel) => no worker is blocked;
;   reduce-root-value           if the root (index 0) terminates, its value is
;                               the sum of the indices 0 + 1 + ... + (n-1).

(in-package "ACL2")

(include-book "scheduler")
(include-book "eval-lemmas")
(include-book "erl/reduce")
(local (include-book "arithmetic/top-with-meta" :dir :system))

; ---------------------------------------------------------------------------
; The program

(defconst *reduce-world* (erl-make-world (list *reduce-module*)))

(defconst *reduce-clauses*
  (erl-lookup-fn *reduce-world* '|reduce| '|reduce| 3))

; the clauses of the receive in the third clause of reduce/3
(defconst *reduce-recv-clauses*
  (cadr (car (clause->body (nth 2 *reduce-clauses*)))))

(defconst *reduce-recv-body*
  (clause->body (car *reduce-recv-clauses*)))

; ---------------------------------------------------------------------------
; Worker trees

(defun tree-parent (i tree) (nth 0 (nth i tree)))
(defun tree-children (i tree) (nth 1 (nth i tree)))
(defun tree-hi (i tree) (nth 2 (nth i tree)))

(defun range-sum (a b)
  ; a + (a+1) + ... + (b-1)
  (declare (xargs :measure (nfix (- b a))))
  (if (and (natp a) (natp b) (< a b))
      (+ a (range-sum (1+ a) b))
    0))

(defun sum-of-indices (n)
  ; 0 + 1 + ... + (n-1)
  (if (zp n) 0 (+ (- n 1) (sum-of-indices (- n 1)))))

(defun rem-start (rem i tree)
  (if (consp rem) (car rem) (tree-hi i tree)))

(defun chain-ok (rem i tree n)
  ; REM is a list of children of node I covering consecutive ranges that end
  ; at the end of I's range.
  (if (atom rem)
      (null rem)
    (let ((c (car rem)))
      (and (natp c) (< i c) (< c n)
           (equal (tree-parent c tree) i)
           (natp (tree-hi c tree))
           (< c (tree-hi c tree))
           (equal (tree-hi c tree) (rem-start (cdr rem) i tree))
           (chain-ok (cdr rem) i tree n)))))

(defun wtree-node-ok (i tree n)
  (and (natp (tree-hi i tree))
       (< i (tree-hi i tree))
       (<= (tree-hi i tree) n)
       (chain-ok (tree-children i tree) i tree n)
       (equal (rem-start (tree-children i tree) i tree) (+ 1 i))
       (if (equal i 0)
           (and (null (tree-parent i tree))
                (equal (tree-hi i tree) n))
         (and (natp (tree-parent i tree))
              (< (tree-parent i tree) i)
              (member i (tree-children (tree-parent i tree) tree))))))

(defun wtree-nodes-ok (k tree n)
  (if (zp k) t
    (and (wtree-node-ok (- k 1) tree n)
         (wtree-nodes-ok (- k 1) tree n))))

(defun wtree-p (tree n)
  (and (posp n)
       (true-listp tree)
       (equal (len tree) n)
       (wtree-nodes-ok n tree n)))

; The binomial tree: the node covering [lo, hi) has as children the nodes
; covering the chunks [lo+1, lo+2), [lo+2, lo+4), [lo+4, lo+8), ...
(defun wtree-chunks (c k hi)
  ; starts of chunks c, c+k, c+3k, ... (sizes k, 2k, 4k, ...) below hi
  (declare (xargs :measure (nfix (- hi c))))
  (if (and (natp c) (natp hi) (posp k) (< c hi))
      (cons c (wtree-chunks (+ c k) (* 2 k) hi))
    nil))

(defun wtree-node (lo hi parent)
  (list parent (wtree-chunks (+ 1 lo) 1 hi) hi))

(mutual-recursion
(defun wtree-build (lo hi parent)
  ; alist from index to node record for the subtree covering [lo, hi)
  (declare (xargs :measure (+ 1 (* 2 (nfix (- (nfix hi) (nfix lo)))))))
  (if (and (natp lo) (natp hi) (< lo hi))
      (cons (cons lo (wtree-node lo hi parent))
            (wtree-build-children (+ 1 lo) 1 hi lo))
    nil))

(defun wtree-build-children (c k hi parent)
  (declare (xargs :measure (+ 2 (* 2 (nfix (- (nfix hi) (nfix c)))))))
  (if (and (natp c) (natp hi) (posp k) (< c hi))
      (append (wtree-build c (min (+ c k) hi) parent)
              (wtree-build-children (+ c k) (* 2 k) hi parent))
    nil)))

(defun alist-to-list (i n alist)
  (declare (xargs :measure (nfix (- n i))))
  (if (and (natp i) (natp n) (< i n))
      (cons (cdr (assoc i alist)) (alist-to-list (+ 1 i) n alist))
    nil))

(defun create-wtree (n)
  (alist-to-list 0 n (wtree-build 0 n nil)))

(assert-event (and (wtree-p (create-wtree 1) 1)
                   (wtree-p (create-wtree 2) 2)
                   (wtree-p (create-wtree 7) 7)
                   (wtree-p (create-wtree 8) 8)
                   (wtree-p (create-wtree 13) 13)))

; ---------------------------------------------------------------------------
; Worker processes.  Worker i has pid (:pid i).

(defun parent-val (i tree)
  (if (natp (tree-parent i tree))
      (list :pid (tree-parent i tree))
    '(:atom |none|)))

(defun pids-to-erl (rem)
  (if (consp rem)
      (list :cons (list :pid (car rem)) (pids-to-erl (cdr rem)))
    '(:nil)))

(defun erl-to-indices (v)
  (if (and (consp v) (eq (car v) :cons))
      (cons (cadr (cadr v)) (erl-to-indices (caddr v)))
    nil))

; The message a worker sends to its parent: {self(), Total}
(defun valid-msg (c tree)
  (list :tuple (list (list :pid c) (list :integer (range-sum c (tree-hi c tree))))))

(defun msg-src (m) (cadr (car (cadr m))))

(defthm msg-src-valid-msg
  (equal (msg-src (valid-msg c tree)) c))

(defthm valid-msg-equal
  (equal (equal (valid-msg c tree) (valid-msg d tree))
         (equal c d)))

(defun valid-msg-p (m tree n)
  (and (natp (msg-src m))
       (< (msg-src m) n)
       (equal m (valid-msg (msg-src m) tree))))

(defun valid-msgs (l tree n)
  (if (atom l) t
    (and (valid-msg-p (car l) tree n)
         (valid-msgs (cdr l) tree n))))

; The environment of a worker blocked in the receive
(defmacro b-env (p c rest tot)
  `(list (cons '|LeftTotal| ,tot)
         (cons '|ChildTl| ,rest)
         (cons '|ChildHd| ,c)
         (cons '|ParentPid| ,p)))

; Ready: about to call reduce(Parent, Rem, Tot)
(defun worker-a-proc (i rem tot inbox tree)
  (make-proc :ready '((:call-local |reduce|))
             (make-estate (list (parent-val i tree) (pids-to-erl rem) (list :integer tot))
                          nil '|reduce| *reduce-world* (list :pid i) inbox nil)))

; Blocked: waiting for the message of child (car rem)
(defun worker-b-proc (i rem tot inbox tree)
  (make-proc :blocked (list (list :receive2 *reduce-recv-clauses*) '(:restore nil |reduce|))
             (make-estate :none
                          (b-env (parent-val i tree) (list :pid (car rem))
                                 (pids-to-erl (cdr rem)) (list :integer tot))
                          '|reduce| *reduce-world* (list :pid i) inbox nil)))

; Done: the root returns its total; other workers return the message sent
(defun done-val (i tree)
  (if (natp (tree-parent i tree))
      (valid-msg i tree)
    (list :integer (range-sum i (tree-hi i tree)))))

(defun worker-done-proc (i inbox outbox tree)
  (make-proc :done nil
             (make-estate (done-val i tree) nil '|reduce| *reduce-world* (list :pid i)
                          inbox outbox)))

; Extractors
(defun proc-inbox (p) (estate->inbox (proc->estate p)))
(defun proc-outbox (p) (estate->outbox (proc->estate p)))
(defun a-rem (p) (erl-to-indices (cadr (estate->val (proc->estate p)))))
(defun a-tot (p) (cadr (caddr (estate->val (proc->estate p)))))
(defun b-env-of (p) (estate->env (proc->estate p)))
(defun b-rem (p)
  (cons (cadr (cdr (assoc-equal '|ChildHd| (b-env-of p))))
        (erl-to-indices (cdr (assoc-equal '|ChildTl| (b-env-of p))))))
(defun b-tot (p) (cadr (cdr (assoc-equal '|LeftTotal| (b-env-of p)))))

(defun outbox-ok (i outbox tree)
  (or (null outbox)
      (and (natp (tree-parent i tree))
           (or (equal outbox (list (cons (list :pid (tree-parent i tree)) nil)))
               (equal outbox (list (cons (list :pid (tree-parent i tree))
                                         (list (valid-msg i tree)))))))))

(defun a-ok (i p tree n)
  (and (equal (proc->status p) :ready)
       (equal p (worker-a-proc i (a-rem p) (a-tot p) (proc-inbox p) tree))
       (chain-ok (a-rem p) i tree n)
       (equal (a-tot p) (range-sum i (rem-start (a-rem p) i tree)))))

(defun b-ok (i p tree n)
  (and (equal (proc->status p) :blocked)
       (equal p (worker-b-proc i (b-rem p) (b-tot p) (proc-inbox p) tree))
       (chain-ok (b-rem p) i tree n)
       (equal (b-tot p) (range-sum i (car (b-rem p))))))

(defun done-ok (i p tree)
  (and (equal (proc->status p) :done)
       (equal p (worker-done-proc i (proc-inbox p) (proc-outbox p) tree))
       (outbox-ok i (proc-outbox p) tree)))

(defun oof-ok (i p tree)
  (and (equal (proc->status p) :out-of-fuel)
       (outbox-ok i (proc-outbox p) tree)))

(defun worker-ok (i p tree n)
  (and (or (a-ok i p tree n)
           (b-ok i p tree n)
           (done-ok i p tree)
           (oof-ok i p tree))
       (valid-msgs (proc-inbox p) tree n)))

; The children worker I is still waiting for
(defun worker-remaining (p)
  (case (proc->status p)
    (:ready (a-rem p))
    (:blocked (b-rem p))
    (otherwise nil)))

; Rules for symbolic evaluation with symbolic lists of children
(defthm car-pids-to-erl
  (equal (car (pids-to-erl x)) (if (consp x) :cons :nil)))
(defthm cdr-pids-to-erl
  (equal (cdr (pids-to-erl x))
         (if (consp x) (list (list :pid (car x)) (pids-to-erl (cdr x))) nil)))
(defthm consp-pids-to-erl
  (consp (pids-to-erl x))
  :rule-classes :type-prescription)
(defthm equal-nil-pids-to-erl
  (equal (equal '(:nil) (pids-to-erl x)) (not (consp x))))
(defthm erl-to-indices-pids-to-erl
  (implies (true-listp x)
           (equal (erl-to-indices (pids-to-erl x)) x)))
(in-theory (disable pids-to-erl))

(defthm chain-ok-true-listp
  (implies (chain-ok rem i tree n) (true-listp rem))
  :rule-classes (:rewrite :forward-chaining))

(defthm chain-ok-cdr
  (implies (chain-ok rem i tree n) (chain-ok (cdr rem) i tree n)))

(defthm subsetp-equal-cons-right
  (implies (subsetp-equal x y) (subsetp-equal x (cons a y))))

(defthm subsetp-equal-refl
  (subsetp-equal x x))

(defthm valid-msgs-remove1
  (implies (valid-msgs l tree n)
           (valid-msgs (remove1-equal x l) tree n)))

(defthm valid-msgs-append
  (equal (valid-msgs (append a b) tree n)
         (and (valid-msgs a tree n) (valid-msgs b tree n))))

(defthm range-sum-split
  (implies (and (natp a) (natp b) (natp c) (<= a b) (<= b c))
           (equal (+ (range-sum a b) (range-sum b c))
                  (range-sum a c))))

(defthm range-sum-split-2
  (implies (and (natp a) (natp b) (natp c) (<= a b) (<= b c))
           (equal (+ (range-sum a b) (range-sum b c) x)
                  (+ (range-sum a c) x)))
  :hints (("Goal" :use range-sum-split :in-theory (disable range-sum-split))))

(defthm integerp-range-sum
  (integerp (range-sum a b))
  :rule-classes :type-prescription)

; What a run of worker I does, from the process OLD to the process NEW.
(defun run-post (i old new tree n)
  (and (worker-ok i new tree n)
       (implies (and (equal (proc->status new) :done)
                     (natp (tree-parent i tree)))
                (equal (proc-outbox new)
                       (list (cons (list :pid (tree-parent i tree))
                                   (list (valid-msg i tree))))))
       (subsetp-equal (worker-remaining new) (worker-remaining old))
       (or (equal (proc-inbox new) (proc-inbox old))
           (and (equal (proc-inbox new)
                       (remove1-equal (valid-msg (car (worker-remaining old)) tree)
                                      (proc-inbox old)))
                (not (member-equal (car (worker-remaining old))
                                   (worker-remaining new)))))))

(defun run-proc (p fuel)
  ; the process after a run (no worker spawns)
  (result-proc (eval-cont-list (proc->klist p) (proc->estate p) fuel)))

(local (in-theory (disable chain-ok range-sum tree-parent tree-hi tree-children
                           eval-cont-list-open)))
(local (in-theory (enable eval-cont-list-open-if)))

; a worker run never requests a spawn
(defun worker-no-spawn (p fuel)
  (not (equal (car (estate->val (eval-cont-list (proc->klist p) (proc->estate p) fuel)))
              :spawn)))

(defthm run-ready-worker
  (implies (and (equal p (worker-a-proc i rem tot inbox tree))
                (natp i)
                (chain-ok rem i tree n)
                (equal tot (range-sum i (rem-start rem i tree)))
                (valid-msgs inbox tree n))
           (and (run-post i p (run-proc p fuel) tree n)
                (worker-no-spawn p fuel)))
  :rule-classes nil)

; ---------------------------------------------------------------------------
; The receive of a blocked worker, on an inbox of valid messages

(defun recv-env (c tree env)
  (cons (cons '|RightTotal| (list :integer (range-sum c (tree-hi c tree)))) env))

(local
 (defthm select-clause-reduce-recv-1
   (implies (and (equal m (valid-msg d tree))
                 (natp c) (natp d))
            (equal (select-clause *reduce-recv-clauses* (list m)
                                  (b-env p (list :pid c) rest tot) self)
                   (if (equal c d)
                       (mv t *reduce-recv-body* (recv-env c tree (b-env p (list :pid c) rest tot)))
                     (mv nil nil (b-env p (list :pid c) rest tot)))))
   :rule-classes nil))

(defthm select-clause-reduce-recv
  (implies (and (valid-msg-p m tree n)
                (natp c))
           (equal (select-clause *reduce-recv-clauses* (list m)
                                 (b-env p (list :pid c) rest tot) self)
                  (if (equal m (valid-msg c tree))
                      (mv t *reduce-recv-body* (recv-env c tree (b-env p (list :pid c) rest tot)))
                    (mv nil nil (b-env p (list :pid c) rest tot)))))
  :hints (("Goal" :use ((:instance select-clause-reduce-recv-1 (d (msg-src m))))
                  :in-theory (disable select-clause valid-msg recv-env msg-src))))

(defthm receive-match-reduce-found
  (implies (and (valid-msgs inbox tree n) (natp c))
           (equal (mv-nth 0 (receive-match inbox *reduce-recv-clauses*
                                           (b-env p (list :pid c) rest tot) self))
                  (if (member-equal (valid-msg c tree) inbox) t nil)))
  :hints (("Goal" :in-theory (disable valid-msg-p valid-msg select-clause recv-env))))

(defthm receive-match-reduce-values
  (implies (and (valid-msgs inbox tree n) (natp c)
                (member-equal (valid-msg c tree) inbox))
           (and (equal (mv-nth 1 (receive-match inbox *reduce-recv-clauses*
                                                (b-env p (list :pid c) rest tot) self))
                       *reduce-recv-body*)
                (equal (mv-nth 2 (receive-match inbox *reduce-recv-clauses*
                                                (b-env p (list :pid c) rest tot) self))
                       (recv-env c tree (b-env p (list :pid c) rest tot)))
                (equal (mv-nth 3 (receive-match inbox *reduce-recv-clauses*
                                                (b-env p (list :pid c) rest tot) self))
                       (remove1-equal (valid-msg c tree) inbox))))
  :hints (("Goal" :in-theory (disable valid-msg-p valid-msg select-clause recv-env))))

(defthm chain-ok-car
  (implies (and (chain-ok rem i tree n) (consp rem))
           (and (integerp (car rem))
                (<= 0 (car rem))
                (< i (car rem))
                (< (car rem) n)
                (equal (tree-parent (car rem) tree) i)
                (integerp (tree-hi (car rem) tree))
                (< (car rem) (tree-hi (car rem) tree))
                (equal (tree-hi (car rem) tree) (rem-start (cdr rem) i tree))))
  :hints (("Goal" :in-theory (enable chain-ok))))

(defthm chain-ok-cadr-natp
  (implies (and (chain-ok rem i tree n) (consp (cdr rem)))
           (and (integerp (cadr rem)) (<= 0 (cadr rem))))
  :hints (("Goal" :in-theory (enable chain-ok))))

(defthm chain-ok-linear-1
  (implies (and (chain-ok rem i tree n) (consp rem))
           (< i (car rem)))
  :rule-classes :linear)

(defthm chain-ok-linear-2
  (implies (and (chain-ok rem i tree n) (consp (cdr rem)))
           (< (car rem) (cadr rem)))
  :rule-classes :linear
  :hints (("Goal" :use chain-ok-car :in-theory (disable chain-ok-car))))

(defthm chain-ok-linear-3
  (implies (and (chain-ok rem i tree n) (consp rem) (not (consp (cdr rem))))
           (< (car rem) (tree-hi i tree)))
  :rule-classes :linear
  :hints (("Goal" :use chain-ok-car :in-theory (disable chain-ok-car))))

(defthm chain-ok-last-hi
  (implies (and (chain-ok rem i tree n) (consp rem) (not (consp (cdr rem))))
           (integerp (tree-hi i tree)))
  :hints (("Goal" :use chain-ok-car :in-theory (disable chain-ok-car))))

(defthm chain-ok-increasing
  (implies (and (chain-ok rem i tree n) (consp rem) (member-equal x (cdr rem)))
           (< (car rem) x))
  :rule-classes nil
  :hints (("Goal" :induct (len rem))
          ("Subgoal *1/1" :use ((:instance chain-ok-linear-2)))))

(defthm chain-ok-not-member-cdr
  (implies (and (chain-ok rem i tree n) (consp rem) (<= x (car rem)))
           (not (member-equal x (cdr rem))))
  :hints (("Goal" :use ((:instance chain-ok-increasing)))))

(defthm rem-start-bound
  (implies (and (chain-ok rem i tree n) (natp i) (natp (tree-hi i tree)) (< i (tree-hi i tree)))
           (< i (rem-start rem i tree)))
  :rule-classes :linear)

(defthm run-blocked-worker
  (implies (and (equal p (worker-b-proc i rem tot inbox tree))
                (natp i)
                (consp rem)
                (chain-ok rem i tree n)
                (equal tot (range-sum i (car rem)))
                (valid-msgs inbox tree n)
                (member-equal (valid-msg (car rem) tree) inbox))
           (and (run-post i p (run-proc p fuel) tree n)
                (worker-no-spawn p fuel)))
  :rule-classes nil
  :hints (("Goal" :do-not-induct t)))

; ---------------------------------------------------------------------------
; From constructor forms to arbitrary processes satisfying the shapes

(defun proc-set-inbox (p inbox)
  (make-proc (proc->status p) (proc->klist p) (update-estate->inbox (proc->estate p) inbox)))

(defun proc-set-outbox (p outbox)
  (make-proc (proc->status p) (proc->klist p) (update-estate->outbox (proc->estate p) outbox)))

(local (in-theory (disable eval-cont-list-open-if)))

(defthm worker-b-proc-has-match
  (implies (and (equal p (worker-b-proc i rem tot inbox tree))
                (natp (car rem))
                (valid-msgs inbox tree n))
           (equal (proc-has-match-p p)
                  (if (member-equal (valid-msg (car rem) tree) inbox) t nil)))
  :rule-classes nil)

(defthm run-worker-ok
  (implies (and (worker-ok i p tree n)
                (natp i)
                (proc-runnable-p p))
           (and (run-post i p (run-proc p fuel) tree n)
                (worker-no-spawn p fuel)))
  :hints (("Goal" :in-theory (e/d (worker-ok)
                                  (run-post run-proc worker-no-spawn worker-a-proc worker-b-proc
                                   worker-done-proc proc-has-match-p a-rem a-tot b-rem b-tot
                                   proc-inbox valid-msgs chain-ok))
                  :use ((:instance run-ready-worker (rem (a-rem p)) (tot (a-tot p))
                                   (inbox (proc-inbox p)))
                        (:instance run-blocked-worker (rem (b-rem p)) (tot (b-tot p))
                                   (inbox (proc-inbox p)))
                        (:instance worker-b-proc-has-match (rem (b-rem p)) (tot (b-tot p))
                                   (inbox (proc-inbox p)))))))

; ---------------------------------------------------------------------------
; The invariant

; If child C has terminated and its parent is still waiting for it, its
; message is in its outbox or in the parent's inbox.
(defun cross-ok (c sys tree)
  (let ((pp (tree-parent c tree)))
    (implies (natp pp)
             (let ((pc (sys-lookup c sys))
                   (ppar (sys-lookup pp sys)))
               (implies (and (equal (proc->status pc) :done)
                             (member-equal c (worker-remaining ppar)))
                        (or (member-equal (valid-msg c tree) (proc-inbox ppar))
                            (equal (proc-outbox pc)
                                   (list (cons (list :pid pp) (list (valid-msg c tree)))))))))))

(defun node-ok (i sys tree n)
  (and (consp (assoc-equal i sys))
       (worker-ok i (sys-lookup i sys) tree n)
       (cross-ok i sys tree)))

(defun-sk all-nodes-ok (sys tree n)
  (forall i (implies (and (natp i) (< i n))
                     (node-ok i sys tree n))))

(defun nat-keys-below (keys n)
  (if (atom keys) t
    (and (natp (car keys)) (< (car keys) n)
         (nat-keys-below (cdr keys) n))))

; The invariant of Section 4.2: the processes are exactly the workers
; 0..n-1, each worker is in one of the states ready / blocked / done / out
; of fuel with the correct partial total (the sum of the indices of the
; subtrees it has heard from plus its own index), every message in transit
; or in an inbox carries the correct subtree total, and a terminated
; worker's message is not lost.
(defun reduce-inv (sys tree n)
  (and (alistp sys)
       (no-duplicatesp-equal (strip-cars sys))
       (nat-keys-below (strip-cars sys) n)
       (all-nodes-ok sys tree n)))

; --- process tables

(defthm assoc-equal-put-assoc-equal
  (equal (assoc-equal i (put-assoc-equal j p sys))
         (if (equal i j) (cons j p) (assoc-equal i sys))))

(defthm strip-cars-put-assoc-equal
  (implies (assoc-equal j sys)
           (equal (strip-cars (put-assoc-equal j p sys)) (strip-cars sys))))

(defthm alistp-put-assoc-equal
  (implies (alistp sys) (alistp (put-assoc-equal j p sys))))

(defthm nat-keys-below-member
  (implies (and (nat-keys-below keys n) (member-equal j keys))
           (and (natp j) (< j n)))
  :rule-classes nil)

(defthm assoc-member-strip-cars
  (implies (and (alistp sys) (assoc-equal j sys))
           (member-equal j (strip-cars sys))))

(defthm nat-keys-below-assoc
  (implies (and (alistp sys) (nat-keys-below (strip-cars sys) n) (assoc-equal j sys))
           (and (natp j) (< j n)))
  :rule-classes nil
  :hints (("Goal" :use ((:instance nat-keys-below-member (keys (strip-cars sys)))))))

; --- the actions available

(defthm member-equal-append
  (iff (member-equal x (append a b))
       (or (member-equal x a) (member-equal x b))))

(local (in-theory (disable proc-runnable-p)))

(defthm outbox-actions-not-run
  (not (member-equal (list :run j) (outbox-actions src o))))

(defthm member-outbox-actions
  (implies (member-equal act (outbox-actions src o))
           (equal act (list :deliver src (caddr act))))
  :rule-classes nil)

(defthm sched-actions-shape
  (implies (member-equal act (sched-actions sys))
           (or (equal act (list :run (cadr act)))
               (equal act (list :deliver (cadr act) (caddr act)))))
  :rule-classes nil
  :hints (("Subgoal *1/2" :use ((:instance member-outbox-actions (src (caar sys))
                                           (o (estate->outbox (proc->estate (cdar sys)))))))))

(defthm member-run-sched-actions-1
  (implies (and (alistp sys)
                (member-equal (list :run j) (sched-actions sys)))
           (assoc-equal j sys)))

(defthm member-run-sched-actions
  (implies (and (alistp sys)
                (no-duplicatesp-equal (strip-cars sys))
                (member-equal (list :run j) (sched-actions sys)))
           (and (assoc-equal j sys)
                (proc-runnable-p (cdr (assoc-equal j sys))))))

(defthm member-run-sched-actions-intro
  (implies (and (alistp sys)
                (assoc-equal j sys)
                (proc-runnable-p (cdr (assoc-equal j sys))))
           (member-equal (list :run j) (sched-actions sys))))

(defthm outbox-actions-other-src
  (implies (not (equal s src))
           (not (member-equal (list :deliver s d) (outbox-actions src o)))))

(defthm member-deliver-sched-actions-1
  (implies (and (alistp sys)
                (member-equal (list :deliver src dest) (sched-actions sys)))
           (assoc-equal src sys)))

(defthm member-deliver-sched-actions
  (implies (and (alistp sys)
                (no-duplicatesp-equal (strip-cars sys))
                (member-equal (list :deliver src dest) (sched-actions sys)))
           (and (assoc-equal src sys)
                (member-equal (list :deliver src dest)
                              (outbox-actions src (estate->outbox (proc->estate
                                                                   (cdr (assoc-equal src sys)))))))))

(defthm member-deliver-sched-actions-intro
  (implies (and (alistp sys)
                (assoc-equal src sys)
                (member-equal (list :deliver src dest)
                              (outbox-actions src (estate->outbox (proc->estate
                                                                   (cdr (assoc-equal src sys)))))))
           (member-equal (list :deliver src dest) (sched-actions sys))))

(defthm consp-when-member
  (implies (member-equal x l) (consp l))
  :rule-classes nil)

; --- running a worker preserves the invariant

(defthm member-subsetp
  (implies (and (subsetp-equal x y) (member-equal a x))
           (member-equal a y)))

(defthm member-remove1-other
  (implies (and (member-equal x l) (not (equal x y)))
           (member-equal x (remove1-equal y l))))

(defthm not-equal-by-member
  (implies (and (member-equal a l) (not (member-equal b l)))
           (not (equal a b))))

(defthm sched-run-worker
  (implies (and (worker-ok j (cdr (assoc-equal j sys)) tree n)
                (natp j)
                (proc-runnable-p (cdr (assoc-equal j sys))))
           (equal (sched-run j sys fuel)
                  (put-assoc-equal j (run-proc (cdr (assoc-equal j sys)) fuel) sys)))
  :hints (("Goal" :use ((:instance run-worker-ok (i j) (p (sys-lookup j sys))))
                  :in-theory (e/d (sched-run run-proc worker-no-spawn)
                                  (run-worker-ok worker-ok run-post result-proc
                                   proc-runnable-p)))))

(defthm node-ok-after-run
  (implies (and (reduce-inv sys tree n)
                (natp j) (< j n)
                (proc-runnable-p (sys-lookup j sys))
                (natp i) (< i n))
           (node-ok i (sys-update j (run-proc (sys-lookup j sys) fuel) sys) tree n))
  :hints (("Goal" :use ((:instance all-nodes-ok-necc (i i))
                        (:instance all-nodes-ok-necc (i j))
                        (:instance run-worker-ok (i j) (p (sys-lookup j sys))))
                  :in-theory (e/d () (all-nodes-ok-necc run-worker-ok worker-ok run-proc
                                      worker-remaining proc-runnable-p valid-msg
                                      worker-no-spawn proc-inbox proc-outbox)))))

(defthm node-ok-implies
  (implies (node-ok i sys tree n)
           (and (consp (assoc-equal i sys))
                (worker-ok i (sys-lookup i sys) tree n)
                (cross-ok i sys tree)))
  :hints (("Goal" :in-theory (enable node-ok))))

(in-theory (disable all-nodes-ok node-ok run-proc sched-run cross-ok))

(defthm all-nodes-ok-after-run
  (implies (and (reduce-inv sys tree n)
                (natp j) (< j n)
                (proc-runnable-p (cdr (assoc-equal j sys))))
           (all-nodes-ok (put-assoc-equal j (run-proc (cdr (assoc-equal j sys)) fuel) sys)
                         tree n))
  :hints (("Goal" :expand ((all-nodes-ok (put-assoc-equal j (run-proc (cdr (assoc-equal j sys))
                                                                      fuel)
                                                          sys)
                                         tree n))
                  :use ((:instance node-ok-after-run
                                   (i (all-nodes-ok-witness
                                       (put-assoc-equal j (run-proc (cdr (assoc-equal j sys)) fuel)
                                                        sys)
                                       tree n))))
                  :in-theory (disable proc-runnable-p node-ok-after-run))))

(defthm reduce-inv-after-run
  (implies (and (reduce-inv sys tree n)
                (member-equal (list :run j) (sched-actions sys)))
           (reduce-inv (sched-run j sys fuel) tree n))
  :hints (("Goal" :use ((:instance all-nodes-ok-necc (i j))
                        (:instance nat-keys-below-assoc)
                        (:instance node-ok-implies (i j)))
                  :in-theory (disable all-nodes-ok-necc proc-runnable-p
                                      node-ok-implies worker-ok))))

; --- delivering a message preserves the invariant

(defthm proc-set-inbox-accessors
  (and (equal (proc->status (proc-set-inbox p i)) (proc->status p))
       (equal (car (proc-set-inbox p i)) (car p))
       (equal (worker-remaining (proc-set-inbox p i)) (worker-remaining p))
       (equal (proc-inbox (proc-set-inbox p i)) i)
       (equal (proc-outbox (proc-set-inbox p i)) (proc-outbox p))
       (equal (a-rem (proc-set-inbox p i)) (a-rem p))
       (equal (a-tot (proc-set-inbox p i)) (a-tot p))
       (equal (b-rem (proc-set-inbox p i)) (b-rem p))
       (equal (b-tot (proc-set-inbox p i)) (b-tot p))))

(defthm proc-set-outbox-accessors
  (and (equal (proc->status (proc-set-outbox p o)) (proc->status p))
       (equal (car (proc-set-outbox p o)) (car p))
       (equal (worker-remaining (proc-set-outbox p o)) (worker-remaining p))
       (equal (proc-inbox (proc-set-outbox p o)) (proc-inbox p))
       (equal (proc-outbox (proc-set-outbox p o)) o)
       (equal (a-rem (proc-set-outbox p o)) (a-rem p))
       (equal (a-tot (proc-set-outbox p o)) (a-tot p))
       (equal (b-rem (proc-set-outbox p o)) (b-rem p))
       (equal (b-tot (proc-set-outbox p o)) (b-tot p))))

(local
 (defthm worker-procs-set-inbox
   (and (implies (equal p (worker-a-proc i rem tot inbox0 tree))
                 (equal (proc-set-inbox p inbox) (worker-a-proc i rem tot inbox tree)))
        (implies (equal p (worker-b-proc i rem tot inbox0 tree))
                 (equal (proc-set-inbox p inbox) (worker-b-proc i rem tot inbox tree)))
        (implies (equal p (worker-done-proc i inbox0 outbox tree))
                 (equal (proc-set-inbox p inbox) (worker-done-proc i inbox outbox tree)))
        (implies (equal p (worker-done-proc i inbox outbox0 tree))
                 (equal (proc-set-outbox p outbox) (worker-done-proc i inbox outbox tree))))
   :rule-classes nil))

(defthm worker-ok-set-inbox
  (implies (and (worker-ok i p tree n)
                (valid-msgs inbox tree n))
           (worker-ok i (proc-set-inbox p inbox) tree n))
  :hints (("Goal" :use ((:instance worker-procs-set-inbox (rem (a-rem p)) (tot (a-tot p))
                                   (inbox0 (proc-inbox p)) (outbox (proc-outbox p)))
                        (:instance worker-procs-set-inbox (rem (b-rem p)) (tot (b-tot p))
                                   (inbox0 (proc-inbox p)) (outbox (proc-outbox p))))
                  :in-theory (disable worker-a-proc worker-b-proc worker-done-proc proc-set-inbox
                                      proc-set-outbox a-rem a-tot b-rem b-tot proc-inbox
                                      proc-outbox valid-msgs chain-ok outbox-ok))))

(defthm worker-ok-set-outbox
  (implies (and (worker-ok i p tree n)
                (or (equal (proc->status p) :done)
                    (equal (proc->status p) :out-of-fuel))
                (outbox-ok i outbox tree))
           (worker-ok i (proc-set-outbox p outbox) tree n))
  :hints (("Goal" :use ((:instance worker-procs-set-inbox (inbox (proc-inbox p))
                                   (outbox0 (proc-outbox p))))
                  :in-theory (disable worker-a-proc worker-b-proc worker-done-proc proc-set-inbox
                                      proc-set-outbox a-rem a-tot b-rem b-tot proc-inbox
                                      proc-outbox valid-msgs chain-ok outbox-ok))))

(defthm deliver-from-outbox-ok
  (implies (and (outbox-ok i o tree)
                (member-equal (list :deliver s d) (outbox-actions s o)))
           (and (natp (tree-parent i tree))
                (equal d (list :pid (tree-parent i tree)))
                (equal o (list (cons d (list (valid-msg i tree)))))))
  :rule-classes nil)

(local
 (defthm worker-procs-outbox
   (and (implies (equal p (worker-a-proc i rem tot inbox tree))
                 (equal (proc-outbox p) nil))
        (implies (equal p (worker-b-proc i rem tot inbox tree))
                 (equal (proc-outbox p) nil)))
   :rule-classes nil))

(defthm worker-ok-sends-only-when-done
  (implies (and (worker-ok i p tree n)
                (consp (proc-outbox p)))
           (or (equal (proc->status p) :done)
               (equal (proc->status p) :out-of-fuel)))
  :rule-classes nil
  :hints (("Goal" :use ((:instance worker-procs-outbox (rem (a-rem p)) (tot (a-tot p))
                                   (inbox (proc-inbox p)))
                        (:instance worker-procs-outbox (rem (b-rem p)) (tot (b-tot p))
                                   (inbox (proc-inbox p))))
                  :in-theory (disable worker-a-proc worker-b-proc worker-done-proc
                                      a-rem a-tot b-rem b-tot proc-inbox proc-outbox))))

(defthm worker-ok-outbox-ok
  (implies (worker-ok i p tree n)
           (outbox-ok i (proc-outbox p) tree))
  :hints (("Goal" :use ((:instance worker-procs-outbox (rem (a-rem p)) (tot (a-tot p))
                                   (inbox (proc-inbox p)))
                        (:instance worker-procs-outbox (rem (b-rem p)) (tot (b-tot p))
                                   (inbox (proc-inbox p))))
                  :in-theory (disable worker-a-proc worker-b-proc worker-done-proc
                                      a-rem a-tot b-rem b-tot proc-inbox proc-outbox))))

(defthm wtree-nodes-ok-node
  (implies (and (wtree-nodes-ok k tree n) (natp k) (natp i) (< i k))
           (wtree-node-ok i tree n))
  :rule-classes nil
  :hints (("Goal" :induct (wtree-nodes-ok k tree n) :in-theory (disable wtree-node-ok))))

(defthm wtree-p-node
  (implies (and (wtree-p tree n) (natp i) (< i n))
           (wtree-node-ok i tree n))
  :rule-classes nil
  :hints (("Goal" :use ((:instance wtree-nodes-ok-node (k n))))))

(defthm wtree-parent-less
  (implies (and (wtree-p tree n) (natp i) (< i n) (natp (tree-parent i tree)))
           (< (tree-parent i tree) i))
  :rule-classes :linear
  :hints (("Goal" :use wtree-p-node :in-theory (disable wtree-p))))

(defun deliver-result (src dest sys tree)
  (let* ((pp (tree-parent src tree))
         (p (cdr (assoc-equal src sys)))
         (d (cdr (assoc-equal pp sys))))
    (put-assoc-equal pp (proc-set-inbox d (append (proc-inbox d) (list (valid-msg src tree))))
                     (put-assoc-equal src (proc-set-outbox p (list (cons dest nil))) sys))))

(defthm deliver-facts
  (implies (and (reduce-inv sys tree n)
                (member-equal (list :deliver src dest) (sched-actions sys)))
           (and (natp src) (< src n)
                (consp (assoc-equal src sys))
                (natp (tree-parent src tree))
                (equal dest (list :pid (tree-parent src tree)))
                (equal (proc-outbox (cdr (assoc-equal src sys)))
                       (list (cons dest (list (valid-msg src tree)))))
                (or (equal (proc->status (cdr (assoc-equal src sys))) :done)
                    (equal (proc->status (cdr (assoc-equal src sys))) :out-of-fuel))
                (worker-ok src (cdr (assoc-equal src sys)) tree n)))
  :rule-classes nil
  :hints (("Goal" :use ((:instance nat-keys-below-assoc (j src))
                        (:instance member-deliver-sched-actions)
                        (:instance all-nodes-ok-necc (i src))
                        (:instance node-ok-implies (i src))
                        (:instance worker-ok-outbox-ok (i src) (p (cdr (assoc-equal src sys))))
                        (:instance deliver-from-outbox-ok (i src) (s src) (d dest)
                                   (o (proc-outbox (cdr (assoc-equal src sys)))))
                        (:instance worker-ok-sends-only-when-done (i src)
                                   (p (cdr (assoc-equal src sys)))))
                  :in-theory (disable all-nodes-ok-necc node-ok-implies worker-ok-outbox-ok
                                      worker-ok outbox-ok valid-msg member-deliver-sched-actions
                                      member-deliver-sched-actions-1))))

(defthm sched-deliver-compute
  (implies (and (consp (assoc-equal src sys))
                (consp (assoc-equal pp sys))
                (not (equal pp src))
                (equal dest (list :pid pp))
                (equal (proc-outbox (cdr (assoc-equal src sys))) (list (cons dest (list m)))))
           (equal (sched-deliver src dest sys)
                  (put-assoc-equal pp (proc-set-inbox (cdr (assoc-equal pp sys))
                                                      (append (proc-inbox (cdr (assoc-equal pp sys)))
                                                              (list m)))
                                   (put-assoc-equal src (proc-set-outbox (cdr (assoc-equal src sys))
                                                                         (list (cons dest nil)))
                                                    sys))))
  :rule-classes nil
  :hints (("Goal" :in-theory (enable sched-deliver proc-set-inbox proc-set-outbox))))

(defthm sched-deliver-worker
  (implies (and (reduce-inv sys tree n)
                (wtree-p tree n)
                (member-equal (list :deliver src dest) (sched-actions sys)))
           (equal (sched-deliver src dest sys)
                  (deliver-result src dest sys tree)))
  :hints (("Goal" :use ((:instance deliver-facts)
                        (:instance all-nodes-ok-necc (i (tree-parent src tree)))
                        (:instance node-ok-implies (i (tree-parent src tree)))
                        (:instance sched-deliver-compute (pp (tree-parent src tree))
                                   (m (valid-msg src tree))))
                  :in-theory (e/d (reduce-inv)
                                  (all-nodes-ok-necc node-ok-implies worker-ok valid-msg
                                   wtree-p sched-deliver proc-set-inbox proc-set-outbox
                                   proc-outbox proc-inbox)))))

(defthm worker-ok-valid-inbox
  (implies (worker-ok i p tree n)
           (valid-msgs (proc-inbox p) tree n))
  :hints (("Goal" :in-theory (enable worker-ok))))

(defthm node-ok-after-deliver
  (implies (and (reduce-inv sys tree n)
                (wtree-p tree n)
                (member-equal (list :deliver src dest) (sched-actions sys))
                (natp i) (< i n))
           (node-ok i (deliver-result src dest sys tree) tree n))
  :hints (("Goal" :use ((:instance deliver-facts)
                        (:instance all-nodes-ok-necc (i i))
                        (:instance all-nodes-ok-necc (i (tree-parent src tree)))
                        (:instance node-ok-implies (i i))
                        (:instance node-ok-implies (i (tree-parent src tree)))
                        (:instance node-ok-implies (i src))
                        (:instance all-nodes-ok-necc (i src))
                        (:instance worker-ok-set-inbox (i (tree-parent src tree))
                                   (p (cdr (assoc-equal (tree-parent src tree) sys)))
                                   (inbox (append (proc-inbox (cdr (assoc-equal (tree-parent src tree)
                                                                                sys)))
                                                  (list (valid-msg src tree)))))
                        (:instance worker-ok-set-outbox (i src)
                                   (p (cdr (assoc-equal src sys)))
                                   (outbox (list (cons dest nil)))))
                  :in-theory (e/d (reduce-inv node-ok cross-ok)
                                  (all-nodes-ok-necc node-ok-implies worker-ok valid-msg
                                   worker-ok-set-inbox worker-ok-set-outbox
                                   wtree-p sched-deliver proc-set-inbox proc-set-outbox
                                   proc-outbox proc-inbox worker-remaining)))))

(defthm all-nodes-ok-after-deliver
  (implies (and (reduce-inv sys tree n)
                (wtree-p tree n)
                (member-equal (list :deliver src dest) (sched-actions sys)))
           (all-nodes-ok (deliver-result src dest sys tree) tree n))
  :hints (("Goal" :expand ((all-nodes-ok (deliver-result src dest sys tree) tree n))
                  :use ((:instance node-ok-after-deliver
                                   (i (all-nodes-ok-witness (deliver-result src dest sys tree)
                                                            tree n))))
                  :in-theory (disable node-ok-after-deliver deliver-result reduce-inv wtree-p))))

(defthm reduce-inv-after-deliver
  (implies (and (reduce-inv sys tree n)
                (wtree-p tree n)
                (member-equal (list :deliver src dest) (sched-actions sys)))
           (reduce-inv (sched-deliver src dest sys) tree n))
  :hints (("Goal" :use ((:instance deliver-facts)
                        (:instance sched-deliver-worker)
                        (:instance all-nodes-ok-after-deliver)
                        (:instance all-nodes-ok-necc (i (tree-parent src tree)))
                        (:instance node-ok-implies (i (tree-parent src tree))))
                  :in-theory (e/d (reduce-inv)
                                  (all-nodes-ok-necc node-ok-implies worker-ok valid-msg
                                   wtree-p sched-deliver proc-set-inbox proc-set-outbox
                                   proc-outbox proc-inbox all-nodes-ok sched-deliver-worker
                                   all-nodes-ok-after-deliver)))))

; ---------------------------------------------------------------------------
; Requirement: the invariant is preserved by message delivery and by running
; a process -- and hence by every step of every scheduler satisfying the
; fairness constraint, and along every trace.

(defthm reduce-inv-after-step
  (implies (and (wtree-p tree n)
                (reduce-inv sys tree n))
           (reduce-inv (sched-step k sys fuel) tree n))
  :hints (("Goal" :use ((:instance sched-actions-shape (act (erl-scheduler k sys)))
                        (:instance reduce-inv-after-run (j (cadr (erl-scheduler k sys))))
                        (:instance reduce-inv-after-deliver (src (cadr (erl-scheduler k sys)))
                                   (dest (caddr (erl-scheduler k sys)))))
                  :in-theory (e/d (sched-step sched-apply)
                                  (reduce-inv wtree-p sched-run sched-deliver
                                   sched-run-worker sched-deliver-worker
                                   reduce-inv-after-run reduce-inv-after-deliver)))))

(defthm reduce-invariant-preserved
  (implies (and (wtree-p tree n)
                (reduce-inv sys tree n))
           (and
            ; running a process
            (implies (member-equal (list :run j) (sched-actions sys))
                     (reduce-inv (sched-run j sys fuel) tree n))
            ; delivering a message
            (implies (member-equal (list :deliver src dest) (sched-actions sys))
                     (reduce-inv (sched-deliver src dest sys) tree n))
            ; a step of the (constrained) scheduler
            (reduce-inv (sched-step k sys fuel) tree n)))
  :hints (("Goal" :use ((:instance reduce-inv-after-run)
                        (:instance reduce-inv-after-deliver)
                        (:instance reduce-inv-after-step))
                  :in-theory (theory 'minimal-theory))))

(defthm reduce-invariant-trace
  (implies (and (wtree-p tree n)
                (reduce-inv sys tree n))
           (reduce-inv (erl-run-sched sys k steps fuel) tree n))
  :hints (("Goal" :induct (erl-run-sched sys k steps fuel)
                  :in-theory (e/d (erl-run-sched) (reduce-inv wtree-p sched-step)))))

; ---------------------------------------------------------------------------
; The initial state: every worker I is about to call
; reduce(Parent, Children, I).  As in the paper, all workers are created by
; an ACL2 function before evaluation begins.

(defun reduce-initial-sys-from (i n tree)
  (declare (xargs :measure (nfix (- n i))))
  (if (and (natp i) (natp n) (< i n))
      (cons (cons i (worker-a-proc i (tree-children i tree) i nil tree))
            (reduce-initial-sys-from (+ 1 i) n tree))
    nil))

(defun reduce-initial-sys (tree n)
  (reduce-initial-sys-from 0 n tree))

(defthm assoc-reduce-initial-sys-from
  (implies (and (natp i) (natp j) (<= i j) (< j n) (natp n))
           (equal (assoc-equal j (reduce-initial-sys-from i n tree))
                  (cons j (worker-a-proc j (tree-children j tree) j nil tree)))))

(defthm assoc-reduce-initial-sys-from-below
  (implies (and (natp i) (natp j) (< j i))
           (not (assoc-equal j (reduce-initial-sys-from i n tree)))))

(defthm alistp-reduce-initial-sys-from
  (alistp (reduce-initial-sys-from i n tree)))

(defthm nat-keys-below-reduce-initial-sys-from
  (nat-keys-below (strip-cars (reduce-initial-sys-from i n tree)) n))

(defthm member-strip-cars-assoc
  (implies (alistp l)
           (iff (member-equal x (strip-cars l)) (assoc-equal x l))))

(defthm no-duplicates-reduce-initial-sys-from
  (no-duplicatesp-equal (strip-cars (reduce-initial-sys-from i n tree))))

(defthm range-sum-one
  (implies (natp i) (equal (range-sum i (+ 1 i)) i))
  :hints (("Goal" :expand ((range-sum i (+ 1 i)) (range-sum (+ 1 i) (+ 1 i))))))

(defthm wtree-p-posp
  (implies (wtree-p tree n) (posp n))
  :rule-classes :forward-chaining)

(defthm initial-worker-ok
  (implies (and (wtree-p tree n) (natp j) (< j n))
           (worker-ok j (worker-a-proc j (tree-children j tree) j nil tree) tree n))
  :hints (("Goal" :use ((:instance wtree-p-node (i j)))
                  :in-theory (disable wtree-p))))

(defthm car-worker-a-proc
  (equal (car (worker-a-proc i rem tot inbox tree)) :ready))

(defthm reduce-inv-initial
  (implies (wtree-p tree n)
           (reduce-inv (reduce-initial-sys tree n) tree n))
  :hints (("Goal" :expand ((all-nodes-ok (reduce-initial-sys-from 0 n tree) tree n))
                  :in-theory (e/d (node-ok cross-ok) (wtree-p worker-ok worker-a-proc
                                                      reduce-initial-sys-from)))))

; ---------------------------------------------------------------------------
; Requirement: invariant + no non-stuttering action => no blocked worker.
; (A worker that ran out of fuel can of course leave its parent waiting
; forever, so we assume no worker is out of fuel.)

(defun worker-status (i sys) (proc->status (sys-lookup i sys)))

(defun no-out-of-fuel-workers (k sys)
  (if (zp k) t
    (and (not (equal (worker-status (- k 1) sys) :out-of-fuel))
         (no-out-of-fuel-workers (- k 1) sys))))

(defun no-blocked-workers (k sys)
  (if (zp k) t
    (and (not (equal (worker-status (- k 1) sys) :blocked))
         (no-blocked-workers (- k 1) sys))))

(defthm no-out-of-fuel-workers-necc
  (implies (and (no-out-of-fuel-workers k sys) (natp i) (< i k) (natp k))
           (not (equal (worker-status i sys) :out-of-fuel)))
  :hints (("Goal" :in-theory (disable worker-status))))

(local
 (defthm worker-procs-misc
   (and (implies (and (equal p (worker-b-proc i rem tot inbox tree))
                      (consp rem) (true-listp rem))
                 (and (equal (proc-outbox p) nil)
                      (equal (worker-remaining p) rem)))
        (implies (equal p (worker-done-proc i inbox outbox tree))
                 (equal (estate->val (proc->estate p)) (done-val i tree))))
   :rule-classes nil))

(defthm outbox-actions-of-single-message
  (implies (equal o (list (cons dest (list m))))
           (member-equal (list :deliver c dest) (outbox-actions c o))))

(defthm blocked-worker-waits-for-blocked-child
  (implies (and (wtree-p tree n)
                (reduce-inv sys tree n)
                (no-out-of-fuel-workers n sys)
                (not (consp (sched-actions sys)))
                (natp i) (< i n)
                (equal (worker-status i sys) :blocked))
           (let ((c (car (b-rem (sys-lookup i sys)))))
             (and (natp c) (< i c) (< c n)
                  (equal (worker-status c sys) :blocked))))
  :rule-classes nil
  :hints (("Goal"
           :use ((:instance all-nodes-ok-necc (i i))
                 (:instance node-ok-implies (i i))
                 (:instance all-nodes-ok-necc (i (car (b-rem (cdr (assoc-equal i sys))))))
                 (:instance node-ok-implies (i (car (b-rem (cdr (assoc-equal i sys))))))
                 (:instance no-out-of-fuel-workers-necc (k n)
                            (i (car (b-rem (cdr (assoc-equal i sys))))))
                 (:instance worker-b-proc-has-match
                            (p (cdr (assoc-equal i sys)))
                            (rem (b-rem (cdr (assoc-equal i sys))))
                            (tot (b-tot (cdr (assoc-equal i sys))))
                            (inbox (proc-inbox (cdr (assoc-equal i sys)))))
                 (:instance worker-procs-misc
                            (p (cdr (assoc-equal i sys)))
                            (rem (b-rem (cdr (assoc-equal i sys))))
                            (tot (b-tot (cdr (assoc-equal i sys))))
                            (inbox (proc-inbox (cdr (assoc-equal i sys)))))
                 (:instance member-run-sched-actions-intro (j i))
                 (:instance member-run-sched-actions-intro
                            (j (car (b-rem (cdr (assoc-equal i sys))))))
                 (:instance member-deliver-sched-actions-intro
                            (src (car (b-rem (cdr (assoc-equal i sys)))))
                            (dest (list :pid i)))
                 (:instance consp-when-member
                            (x (list :run i)) (l (sched-actions sys)))
                 (:instance consp-when-member
                            (x (list :run (car (b-rem (cdr (assoc-equal i sys))))))
                            (l (sched-actions sys)))
                 (:instance consp-when-member
                            (x (list :deliver (car (b-rem (cdr (assoc-equal i sys))))
                                     (list :pid i)))
                            (l (sched-actions sys))))
           :in-theory (e/d (cross-ok worker-ok a-ok b-ok done-ok oof-ok proc-runnable-p
                            proc-outbox)
                           (all-nodes-ok-necc node-ok-implies no-out-of-fuel-workers-necc
                            member-run-sched-actions-intro member-deliver-sched-actions-intro
                            wtree-p worker-a-proc worker-b-proc worker-done-proc
                            proc-has-match-p b-rem b-tot a-rem a-tot proc-inbox
                            worker-remaining valid-msg)))))

(defun blocked-chain-ind (i sys n)
  (declare (xargs :measure (nfix (- n i))))
  (let ((c (car (b-rem (sys-lookup i sys)))))
    (if (and (natp i) (natp c) (< i c) (natp n) (< c n))
        (blocked-chain-ind c sys n)
      t)))

(defthm worker-not-blocked
  (implies (and (wtree-p tree n)
                (reduce-inv sys tree n)
                (no-out-of-fuel-workers n sys)
                (not (consp (sched-actions sys)))
                (natp i) (< i n))
           (not (equal (worker-status i sys) :blocked)))
  :hints (("Goal" :induct (blocked-chain-ind i sys n)
                  :in-theory (disable wtree-p reduce-inv worker-status no-out-of-fuel-workers
                                      b-rem))
          ("Subgoal *1/2" :use ((:instance blocked-worker-waits-for-blocked-child)))
          ("Subgoal *1/1" :use ((:instance blocked-worker-waits-for-blocked-child)))))

(defthm no-blocked-workers-below
  (implies (and (wtree-p tree n)
                (reduce-inv sys tree n)
                (no-out-of-fuel-workers n sys)
                (not (consp (sched-actions sys)))
                (natp k) (<= k n))
           (no-blocked-workers k sys))
  :hints (("Goal" :induct (no-blocked-workers k sys)
                  :in-theory (disable wtree-p reduce-inv worker-status no-out-of-fuel-workers))))

(defthm reduce-no-blocked-worker
  (implies (and (wtree-p tree n)
                (reduce-inv sys tree n)
                (no-out-of-fuel-workers n sys)
                ; no non-stuttering action is left for the scheduler
                (not (consp (sched-actions sys))))
           (no-blocked-workers n sys))
  :hints (("Goal" :in-theory (disable wtree-p reduce-inv worker-status no-out-of-fuel-workers))))

; ---------------------------------------------------------------------------
; Requirement: if the root (index 0) terminates, its value is the sum of
; the indices.

(defthm range-sum-0-is-sum-of-indices
  (implies (natp n)
           (equal (range-sum 0 n) (sum-of-indices n)))
  :hints (("Goal" :induct (sum-of-indices n))
          ("Subgoal *1/2" :use ((:instance range-sum-split (a 0) (b (- n 1)) (c n))
                                (:instance range-sum-one (i (- n 1)))))))

(defthm reduce-root-value
  (implies (and (wtree-p tree n)
                (reduce-inv sys tree n)
                (equal (worker-status 0 sys) :done))
           (equal (estate->val (proc->estate (sys-lookup 0 sys)))
                  (make-erl-val-integer :val (sum-of-indices n))))
  :hints (("Goal" :use ((:instance all-nodes-ok-necc (i 0))
                        (:instance node-ok-implies (i 0))
                        (:instance wtree-p-node (i 0))
                        (:instance worker-procs-misc (i 0)
                                   (p (cdr (assoc-equal 0 sys)))
                                   (inbox (proc-inbox (cdr (assoc-equal 0 sys))))
                                   (outbox (proc-outbox (cdr (assoc-equal 0 sys))))))
                  :in-theory (e/d (worker-ok done-ok a-ok b-ok oof-ok)
                                  (all-nodes-ok-necc node-ok-implies wtree-p
                                   worker-a-proc worker-b-proc worker-done-proc
                                   proc-inbox proc-outbox)))))

; The end-to-end statement: for every scheduler satisfying the fairness
; constraint, every amount of fuel and every number of steps, if the root
; worker of the initial worker tree has terminated, it holds the sum of the
; indices 0 + ... + (n-1), which equals sum_of_nats(n-1).
(defthm reduce-root-value-any-trace
  (implies (and (wtree-p tree n)
                (equal (worker-status 0 (erl-run-sched (reduce-initial-sys tree n) k steps fuel))
                       :done))
           (equal (estate->val (proc->estate
                                (sys-lookup 0 (erl-run-sched (reduce-initial-sys tree n)
                                                             k steps fuel))))
                  (make-erl-val-integer :val (sum-of-indices n))))
  :hints (("Goal" :use ((:instance reduce-root-value
                                   (sys (erl-run-sched (reduce-initial-sys tree n) k steps fuel)))
                        (:instance reduce-invariant-trace (sys (reduce-initial-sys tree n)))
                        (:instance reduce-inv-initial))
                  :in-theory (theory 'minimal-theory))))

(defthm sum-of-indices-closed-form
  (implies (natp n)
           (equal (sum-of-indices n) (/ (* n (- n 1)) 2)))
  :hints (("Goal" :induct (sum-of-indices n))))

; Executable check: run the workers of a 7-node tree under the executable
; scheduler; the root ends with 0+1+...+6 = 21, nobody is blocked.
(defun reduce-run (n fuel)
  (erl-run-sched (reduce-initial-sys (create-wtree n) n) 0 fuel fuel))

(assert-event
 (let ((sys (reduce-run 7 1000)))
   (and (equal (worker-status 0 sys) :done)
        (equal (estate->val (proc->estate (sys-lookup 0 sys)))
               (make-erl-val-integer :val 21))
        (no-blocked-workers 7 sys))))
