(ld "names.lsp")
(defun dump-fns (fns w)
  (declare (xargs :mode :program))
  (if (endp fns) nil
    (cons (list (car fns)
                (formals (car fns) w)
                (body (car fns) nil w)
                (getpropc (car fns) 'justification nil w)
                (getpropc (car fns) 'guard nil w)
                (getpropc (car fns) 'symbol-class nil w))
          (dump-fns (cdr fns) w))))
(defun dump-macs (ms w)
  (declare (xargs :mode :program))
  (if (endp ms) nil
    (cons (list (car ms) (getpropc (car ms) 'macro-args nil w)
                (getpropc (car ms) 'macro-body nil w))
          (dump-macs (cdr ms) w))))
(defun dump-encs (fs w)
  (declare (xargs :mode :program))
  (if (endp fs) nil
    (cons (list (car fs) (formals (car fs) w)
                (mv-let (a n c) (constraint-info (car fs) w) (list a n c)))
          (dump-encs (cdr fs) w))))
(mv-let (ch state) (open-output-channel (@ dump-file) :object state)
  (pprogn (print-object$ (dump-fns *fns* (w state)) ch state)
          (print-object$ (dump-macs *macs* (w state)) ch state)
          (print-object$ (dump-encs *encs* (w state)) ch state)
          (close-output-channel ch state)))
