               OUTS-ROWP INDEX-LISTP ALGO-CORRECTP CONS THROW-NONEXEC-ERROR
               BIT-MATP BIT-LISTNP NFIX EVAL-ALGO EVAL-ALGO-ROWS EVAL-ALGO-ROW
               ALGO-ENTRY NTH ENDP PRODS-XOR PROD-VALUE EVAL-LFORM MAT-ENTRY
               BIT-LIST-LISTP BIT-LIST-P BITXOR BVXOR BVCHOP IFIX EXPT ZIP =
               FIX UNARY-/ BINARY-* ABS MINUSP MOD FLOOR
               NONNEGATIVE-INTEGER-QUOTIENT RETURN-LAST BINARY-LOGXOR
               BINARY-LOGEQV LOGORC1 LOGNOT BINARY-LOGIOR BINARY-LOGAND EVENP
               BITAND BVAND NAT-LISTP BIT-MAT-MUL BIT-MAT-MUL-ROWS
               BIT-MAT-MUL-ROW MAT-MUL-ENTRY IMPLIES MV-NTH
               ALGO-CORRECTP-WITNESS ALGO-SCHEME ALGO-TRIPLES TRIPLES-FROM
               LFORM-MAT BIT-MAT-UNIT BIT-UNIT-LIST BIT-LISTN0 REPEAT
               MAKE-LIST-AC BIT-MAT0 BIT-MAT-ADD BIT-LIST-ADD BIT-MAT-SCALE
               BIT-LIST-SCALE C-MAT C-MAT-ROW OCC-PARITY IDX-ROWP IDX-TABLEP
               INSERT-ALL-NONZERO SUMMAND0P SUMMAND-A MAT-TRIPLEP SUMMAND-B
               SUMMAND-C OBAG::INSERT OBAG::EMPTYP OBAG::BFIX OBAG::BAGP
               FAST-<< SYMBOL< SYMBOL-PACKAGE-NAME STRING< STRING<-L CHAR<
               CHAR-CODE SYMBOL-NAME BAD-ATOM<= BAD-ATOM << LEXORDER ALPHORDER
               STRING<= OBAG::HEAD OBAG::TAIL MAT-TRIPLE-LISTP CORRECT-SCHEMEP
               SCHEMEP SUMMAND-LISTP SUMMANDP SCHEME-SUM SUMMAND-TENSOR TENSOR
               MAT-FLAT BINARY-APPEND BIT-LIST-OUTER MM-TENSOR MM-TENSOR-1
               MM-TENSOR-2 MM-TENSOR-3)
