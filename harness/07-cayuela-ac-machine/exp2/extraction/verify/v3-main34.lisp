; cert_param: (uses-acl2r)
(in-package "ACL2")
(include-book "authors/06-generic-omega-collapse-acl2r")

; ---- Part B of defs.lisp, verbatim ----
(defun g-cplxp (u)
  (declare (xargs :guard t))
  (and (consp u) (acl2-numberp (car u)) (acl2-numberp (cdr u))))
(defun g-re (u) (declare (xargs :guard (consp u))) (car u))
(defun g-im (u) (declare (xargs :guard (consp u))) (cdr u))
(defun g-cplx (a b)
  (declare (xargs :guard (and (acl2-numberp a) (acl2-numberp b))))
  (cons a b))

(defun g-realpairp (u)
  (declare (xargs :guard t))
  (and (consp u) (realp (g-re u)) (realp (g-im u))))

(defun g-c+ (u v)
  (declare (xargs :guard (and (g-cplxp u) (g-cplxp v))))
  (g-cplx (+ (g-re u) (g-re v)) (+ (g-im u) (g-im v))))
(defun g-cscale (k u)
  (declare (xargs :guard (and (acl2-numberp k) (g-cplxp u))))
  (g-cplx (* k (g-re u)) (* k (g-im u))))

(defun g-c* (u v)
  (declare (xargs :guard (and (g-cplxp u) (g-cplxp v))))
  (g-cplx (- (* (g-re u) (g-re v)) (* (g-im u) (g-im v)))
          (+ (* (g-re u) (g-im v)) (* (g-im u) (g-re v)))))

(defun g-vdot (u v)
  (declare (xargs :guard (and (g-cplxp u) (g-cplxp v))))
  (+ (* (g-re u) (g-re v)) (* (g-im u) (g-im v))))

; omega^n
(defun g-omega-pow (omega n)
  (declare (xargs :guard (and (g-cplxp omega) (natp n))
                  :verify-guards nil))
  (if (zp n) (g-cplx 1 0) (g-c* omega (g-omega-pow omega (1- n)))))

(local
 (defthm g-cplxp-of-g-omega-pow
   (implies (g-cplxp omega) (g-cplxp (g-omega-pow omega n)))))

(verify-guards g-omega-pow)

; sum_{n=0}^{2} (2/3)(A . omega^n) omega^n
(defun g-collapse-sum (A omega)
  (declare (xargs :guard (and (g-cplxp A) (g-cplxp omega))))
  (g-c+ (g-cscale (* 2/3 (g-vdot A (g-omega-pow omega 0))) (g-omega-pow omega 0))
        (g-c+ (g-cscale (* 2/3 (g-vdot A (g-omega-pow omega 1))) (g-omega-pow omega 1))
              (g-cscale (* 2/3 (g-vdot A (g-omega-pow omega 2))) (g-omega-pow omega 2)))))

; gamma = 2*pi/3
(defun g-gamma-val () (* 2/3 (acl2-pi)))

; omega = e^{j 2pi/3}
(defun g-omega-real () (g-cplx (acl2-cosine (g-gamma-val)) (acl2-sine (g-gamma-val))))

; ---- Equivalence of each renamed function with the authors' original ----
(defthm g-cplxp-is-cplxp (equal (g-cplxp u) (cplxp u)))
(defthm g-re-is-re (equal (g-re u) (re u)))
(defthm g-im-is-im (equal (g-im u) (im u)))
(defthm g-cplx-is-cplx (equal (g-cplx a b) (cplx a b)))
(defthm g-realpairp-is-realpairp (equal (g-realpairp u) (realpairp u)))
(defthm g-c+-is-c+ (equal (g-c+ u v) (c+ u v)))
(defthm g-cscale-is-cscale (equal (g-cscale k u) (cscale k u)))
(defthm g-c*-is-c* (equal (g-c* u v) (c* u v)))
(defthm g-vdot-is-vdot (equal (g-vdot u v) (vdot u v)))
(defthm g-omega-pow-is-omega-pow (equal (g-omega-pow omega n) (omega-pow omega n))
  :hints (("Goal" :in-theory (disable g-c*-is-c* g-cplx-is-cplx)
                  :induct (omega-pow omega n))
          ("Subgoal *1/2" :in-theory (enable g-c*-is-c*))))
(defthm g-collapse-sum-is-collapse-sum (equal (g-collapse-sum a omega) (collapse-sum a omega))
  :hints (("Goal" :in-theory (union-theories '(g-collapse-sum collapse-sum g-omega-pow-is-omega-pow
                                               g-vdot-is-vdot g-cscale-is-cscale g-c+-is-c+)
                                             (theory 'minimal-theory)))))
; The only body change: 2/3*pi vs. pi/3+pi/3.
(defthm g-gamma-val-is-gamma-val (equal (g-gamma-val) (gamma-val)))
(defthm g-omega-real-is-omega-real (equal (g-omega-real) (omega-real))
  :hints (("Goal" :in-theory '(g-omega-real omega-real g-cplx-is-cplx g-gamma-val-is-gamma-val))))

; ---- Targets ----
(defthm MAIN-3
  (implies (and (g-realpairp A) (g-realpairp omega)
                (equal (g-c+ (g-cplx 1 0) (g-c+ omega (g-c* omega omega)))
                       (g-cplx 0 0)))
           (equal (g-collapse-sum A omega) A))
  :hints (("Goal" :use trinary-collapse-lemma
                  :in-theory '(g-realpairp-is-realpairp g-c+-is-c+ g-cplx-is-cplx
