;; Grader for tool-arrayset, R4 (non-vacuity): the hypotheses of the four theorems of Figs. 8-9 hold on a
;; concrete arrayset, the analogue (at the model's ARR_SZ) of Figure 4(a), built with the model's own
;; functions: start from aset_init, add 22, then add 33.  By Fig. 5, aset_add stores the value at the
;; used head, so the used list is then 33, 22 as in Figure 4(a).
;; grader-init (generated by grade.sh from the arity of the model's ASET_INIT) is (aset_init) or
;; (aset_init nil).
(in-package "RTL")
(include-book "grader-init")

(defconst *grader-s1* (aset_add 22 (grader-init)))      ; before the second add
(defconst *grader-a* (aset_add 33 *grader-s1*))         ; Figure 4(a): contents {33, 22}

;; Fig. 8, aset_add-val-at-used_head--thm, on aset = *grader-s1*, val = 33
(assert-event (asetp *grader-s1*))
(assert-event (aset-free-to-used-preconditionp *grader-s1*))
(assert-event (unsigned-byte-p 64 33))

;; Fig. 8, aset_del-val-at-free_head--thm, on aset = *grader-a*, val = 22 (the deletion of Figure 4)
(assert-event (asetp *grader-a*))
(assert-event (aset-used-to-free-preconditionp *grader-a*))
(assert-event (no-dups-anext *grader-a*))
(assert-event (unsigned-byte-p 64 22))
(assert-event (< (aset_find_val_from (ag 'used_lst *grader-a*) 22 *grader-a*) (ARR_SZ)))

;; Fig. 9, both theorems, on aset = *grader-a*
(assert-event (= (+ (len (aset-used-list *grader-a*)) (len (aset-free-list *grader-a*)))
                 (1- (ARR_SZ))))
