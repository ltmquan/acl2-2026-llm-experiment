; Grader book for tool-definductive, requirement 2 (model's examples.lisp):
; after including /work/examples.lisp, the paper's predicates exist, defined
; by the tool (as defun-sk over proof trees), on the stub r.
; (check-examples.py checks that the four definductive calls in examples.lisp
; are the paper's.)

(in-package "ACL2")

(include-book "examples")
(include-book "grader-utils")

(grader-assert r2x-stub-r
  (and (equal (len (grader-formals 'r (w state))) 2)
       (not (getpropc 'r 'unnormalized-body nil (w state))))
  "r is not an undefined (stub) binary function")

(grader-assert r2x-preds
  (and (equal (grader-formals 'r* (w state)) '(a b))
       (equal (grader-formals 'nat (w state)) '(n))
       (equal (grader-formals 'tree (w state)) '(tr))
       (equal (grader-formals 'trees (w state)) '(trs))
       (equal (grader-formals 'even (w state)) '(n))
       (equal (grader-formals 'odd (w state)) '(n))
       (equal (grader-formals 'p (w state)) '(x)))
  "the predicates r*, nat, tree, trees, even, odd, p of the four paper examples are not all defined with the paper's formals")

(grader-assert r2x-defined-by-tool
  (and (function-symbolp 'r*-proof-validp (w state))
       (function-symbolp 'nat-proof-validp (w state))
       (function-symbolp 'tree-proof-validp (w state))
       (function-symbolp 'trees-proof-validp (w state))
       (function-symbolp 'even-proof-validp (w state))
       (function-symbolp 'odd-proof-validp (w state))
       (function-symbolp 'p-proof-validp (w state)))
  "the proof tree validity functions generated by the tool for the four examples are missing")

(grader-final)
