;;; aset_init

(defun init-next (j)
  (cond ((equal j 0) 0)
        ((equal j (1- (arr_sz))) 1)
        (t (1+ j))))

(defthm aset_init-loop-0-fields
  (implies (natp i)
           (and (equal (ag 'used_lst (aset_init-loop-0 i aset))
                       (ag 'used_lst aset))
                (equal (ag 'free_lst (aset_init-loop-0 i aset))
                       (ag 'free_lst aset))))
  :hints (("Goal" :in-theory (enable aset_init-loop-0))))

(defthm aset_init-loop-0-anext
  (implies (and (natp i) (natp j))
           (equal (ag j (ag 'anext (aset_init-loop-0 i aset)))
                  (if (and (<= i j) (< j (arr_sz)))
                      (init-next j)
                    (ag j (ag 'anext aset)))))
  :hints (("Goal" :in-theory (enable aset_init-loop-0 log= ag-of-as-redux))))

(defthm aset_init-fields
  (and (equal (ag 'used_lst (aset_init aset)) (arr_sz))
       (equal (ag 'free_lst (aset_init aset)) (1- (arr_sz)))
       (equal (ag 'err (aset_init aset)) 1)
       (implies (and (natp j) (< j (arr_sz)))
                (equal (ag j (ag 'anext (aset_init aset)))
                       (init-next j))))
  :hints (("Goal" :in-theory (enable aset_init))))

(in-theory (disable init-next))

(defun anext-init-okp (i n a)
  (declare (xargs :measure (nfix (- n i))))
  (if (and (natp i) (natp n) (< i n))
      (and (equal (ag i a) (init-next i))
           (anext-init-okp (1+ i) n a))
    t))

(defthm anext-rangep-when-init
  (implies (and (anext-init-okp i (arr_sz) a) (natp i))
           (anext-rangep i (arr_sz) a))
  :hints (("Goal" :in-theory (enable anext-rangep init-next))))

(defthm anext-init-okp-aset_init
  (implies (natp i)
           (anext-init-okp i (arr_sz) (ag 'anext (aset_init aset)))))

(defun iota-from (i n)
  (declare (xargs :measure (nfix (- n i))))
  (if (and (natp i) (natp n) (< i n))
      (cons i (iota-from (1+ i) n))
    nil))

(defthm member-iota-from
  (implies (and (natp i) (natp j) (< j i))
           (not (member-equal j (iota-from i n)))))

(defthm no-duplicatesp-iota-from
  (no-duplicatesp-equal (iota-from i n)))

(defthm len-iota-from
  (implies (and (natp i) (natp n) (<= i n))
           (equal (len (iota-from i n)) (- n i))))

(defun walk-init-ind (i k)
  (declare (xargs :measure (nfix k)))
  (if (zp k) (list i k) (walk-init-ind (1+ i) (1- k))))

(defthm aset-walk-init
  (implies (and (natp i) (< 0 i) (< i (arr_sz))
                (natp k) (<= (- (arr_sz) i) k))
           (and (aset-walk-closedp i (1- (arr_sz)) k
                                   (ag 'anext (aset_init aset)))
                (equal (aset-walk i (1- (arr_sz)) k
                                  (ag 'anext (aset_init aset)))
                       (iota-from i (arr_sz)))))
  :hints (("Goal" :induct (walk-init-ind i k)
           :in-theory (enable init-next)
           :expand ((aset-walk i (1- (arr_sz)) k (ag 'anext (aset_init aset)))
                    (aset-walk-closedp i (1- (arr_sz)) k
                                       (ag 'anext (aset_init aset)))))))

(defthm aset_init-free-list
  (equal (aset-free-list (aset_init aset))
         (iota-from 1 (arr_sz)))
  :hints (("Goal" :in-theory (enable aset-free-list aset-free-nonemptyp
                                     init-next))))

(defthm aset_init-used-list
  (equal (aset-used-list (aset_init aset)) nil)
  :hints (("Goal" :in-theory (enable aset-used-list aset-used-nonemptyp))))

(defthm aset_init-establishes-asetp
  (and (asetp (aset_init aset))
       (aset-sizes-okp (aset_init aset))
       (aset-free-to-used-preconditionp (aset_init aset)))
  :hints (("Goal" :in-theory (enable asetp aset-lists-wfp aset-used-nonemptyp
                                     aset-free-nonemptyp
                                     aset-free-to-used-preconditionp
                                     aset-common-preconditionp init-next))))
